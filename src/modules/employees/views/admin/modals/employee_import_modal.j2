<!-- Employee Import Modal -->
<div class="emp-modal-backdrop" id="emp-import-modal-backdrop" x-show="isOpen" style="display: none;" x-cloak
    @click.self="close" @emp-import-open.window="open()" x-data="employeeImportModal()">
    <div class="emp-modal emp-modal--lg" @click.stop>
        <div class="emp-modal-header">
            <h3 class="emp-modal-title">Import nhân viên</h3>
            <button class="emp-modal-close" @click="close" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- Step indicator -->
        <div class="emp-steps">
            <div class="emp-step" :class="{ 'emp-step--active': step === 'url', 'emp-step--done': step === 'map' }">
                <div class="emp-step-dot">1</div>
                <span>Chọn file dữ liệu</span>
            </div>
            <div class="emp-step-line"></div>
            <div class="emp-step" :class="{ 'emp-step--active': step === 'map' }">
                <div class="emp-step-dot">2</div>
                <span>Map cột dữ liệu</span>
            </div>
        </div>

        <!-- Step 1: URL -->
        <div class="emp-modal-body" x-show="step === 'url'" x-transition>
            <div class="emp-form-group emp-form-group--full">
                <label class="emp-form-label">Chọn tệp hoặc dán URL file (Excel / CSV)</label>
                <div style="display: flex; gap: 8px;">
                    <input type="url" class="emp-form-input" style="flex: 1;" x-model="fileUrl"
                        @input.debounce.500ms="onFileUrlChanged()" placeholder="https://example.com/employees.xlsx"
                        autocomplete="off" />
                    <button type="button" class="emp-btn emp-btn-secondary" @click="$dispatch('emp-media-picker-open')">
                        <span class="material-symbols-outlined">folder_open</span>
                        Chọn từ Thư viện
                    </button>
                </div>
                <p class="emp-form-hint">Hỗ trợ file .xlsx, .xls, .csv, .json từ máy tính hoặc Media Manager</p>
                <p class="emp-form-hint" x-show="fileValidation.status === 'checking'">Đang kiểm tra file...</p>
                <p class="emp-form-hint" x-show="fileValidation.status === 'valid'"
                    x-text="'File hợp lệ' + (fileValidation.type ? ' (' + fileValidation.type + ')' : '')"></p>
                <p class="emp-form-hint" x-show="fileValidation.status === 'invalid'"
                    style="color: var(--danger, #ef4444);" x-text="fileValidation.message"></p>
                <p class="emp-form-hint" x-show="fileValidation.status === 'unknown'" x-text="fileValidation.message">
                </p>
            </div>

            <div class="emp-form-row">
                <div class="emp-form-group">
                    <label class="emp-form-label">Dòng tiêu đề</label>
                    <input type="number" class="emp-form-input" x-model.number="headerRow" min="1" max="20" />
                </div>
                <div class="emp-form-group">
                    <label class="emp-form-label">Số dòng preview</label>
                    <input type="number" class="emp-form-input" x-model.number="rowCount" min="1" max="100" />
                </div>
            </div>

            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-ghost" @click="close">Huỷ</button>
                <button type="button" class="emp-btn emp-btn-primary" @click="previewFile"
                    :disabled="loading || !fileUrl.trim()">
                    <span x-show="loading" class="emp-spinner emp-spinner-sm"></span>
                    <span x-text="loading ? 'Đang tải...' : 'Xem trước & Map cột'">Xem trước & Map cột</span>
                </button>
            </div>
        </div>

        <!-- Step 2: Column mapping -->
        <div class="emp-modal-body" x-show="step === 'map'" x-transition>
            <div x-show="previewData && previewData.rows && previewData.rows.length > 0">
                <p class="emp-form-hint" style="margin-bottom: 8px;">
                    Preview (<span x-text="previewData?.rows?.length || 0"></span> dòng đầu):
                </p>
                <div class="emp-preview-table-wrapper">
                    <table class="emp-preview-table">
                        <thead>
                            <tr>
                                <template x-for="h in (previewData?.headers || [])" :key="h">
                                    <th class="emp-preview-th" x-text="h"></th>
                                </template>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="(row, ri) in (previewData?.rows || []).slice(0, 5)" :key="ri">
                                <tr>
                                    <template x-for="h in (previewData?.headers || [])" :key="h">
                                        <td class="emp-preview-td" x-text="row[h] ?? '—'"></td>
                                    </template>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="emp-col-map">
                <p class="emp-form-label" style="margin-bottom: 12px; font-weight: 600;">Map cột dữ liệu:</p>
                <div class="emp-col-map-grid">
                    <template x-for="field in requiredFields" :key="field">
                        <div class="emp-form-group">
                            <label class="emp-form-label" x-text="fieldLabels[field]"></label>
                            <select class="emp-form-input emp-form-select" x-model="columnMap[field]">
                                <option value="">-- Không map --</option>
                                <template x-for="h in (previewData?.headers || [])" :key="h">
                                    <option :value="h" x-text="h"></option>
                                </template>
                            </select>
                        </div>
                    </template>
                </div>
            </div>

            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-ghost" @click="step = 'url'">
                    <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>
                    Quay lại
                </button>
                <button type="button" class="emp-btn emp-btn-primary" @click="importData" :disabled="loading">
                    <span x-show="loading" class="emp-spinner emp-spinner-sm"></span>
                    <span x-text="loading ? 'Đang import...' : 'Import'">Import</span>
                </button>
            </div>
        </div>
    </div>
</div>

