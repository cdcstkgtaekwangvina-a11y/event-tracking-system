{% extends "templates/layouts/admin.j2" if not request.headers.get("hx-request") else "templates/layouts/admin_blank.j2"
%}

{% block admin_title %}Quản lý sự kiện{% endblock %}

{% block admin_body %}
<link rel="stylesheet" href="/static/css/admin_events.css">
<script src="/static/js/admin_events.js"></script>

<div class="admin-events-container" x-data="adminEventsApp()" @open-edit-modal.window="openEditModal($event.detail)"
    @delete-event.window="deleteEventById($event.detail.id, $event.detail.name)"
    @event-image-media-selected.window="useMediaImage($event.detail)">

    <!-- Header Section -->
    <div class="admin-events-header">
        <h1 class="admin-title-text">Quản lý Sự kiện</h1>
        <button type="button" class="btn-create-event" @click="openCreateModal()">
            <span class="material-symbols-outlined">add</span>
            Tạo sự kiện mới
        </button>
    </div>

    <!-- Filter and Search Bar (Horizontal layout) -->
    <div class="admin-filter-bar">
        <div class="admin-search-wrapper">
            <span class="material-symbols-outlined admin-search-icon">search</span>
            <input type="text" name="search" placeholder="Tìm kiếm sự kiện theo tên hoặc địa điểm..." x-model="search"
                @input.debounce.300ms="$dispatch('search-changed')" class="admin-search-input" />
        </div>

        <div class="admin-event-controls" aria-label="Bộ lọc và sắp xếp sự kiện">
            <label>Trạng thái
                <select name="status" @change="$dispatch('admin-event-filters-changed')">
                    <option value="all">Tất cả sự kiện</option>
                    <option value="ongoing">Đang diễn ra</option>
                    <option value="upcoming">Sắp diễn ra</option>
                    <option value="ended">Đã kết thúc</option>
                </select>
            </label>
            <label>Sắp xếp
                <select name="sort_field" @change="$dispatch('admin-event-filters-changed')">
                    <option value="start_at">Thời gian bắt đầu</option>
                    <option value="name">Tên sự kiện</option>
                    <option value="created_at">Ngày tạo</option>
                    <option value="updated_at">Cập nhật gần nhất</option>
                </select>
            </label>
            <label>Thứ tự
                <select name="is_desc" @change="$dispatch('admin-event-filters-changed')">
                    <option value="false">Tăng dần</option>
                    <option value="true">Giảm dần</option>
                </select>
            </label>
        </div>
    </div>

    <!-- Event Cards Grid Container -->
    <div id="admin-events-container" hx-get="/api/events/admin-cards-html"
        hx-trigger="load, search-changed from:body, admin-event-filters-changed from:body, refresh-events from:body"
        hx-include="[name='search'], [name='status'], [name='sort_field'], [name='is_desc']" hx-swap="innerHTML">
        <div class="admin-no-events">
            <div class="spinner-sm"></div>
            <p>Đang tải danh sách sự kiện...</p>
        </div>
    </div>

    <!-- Create/Edit Event Modal -->
    <div class="admin-modal-overlay" x-show="modalOpen" x-cloak style="display: none;"
        @keydown.escape.window="closeModal()">
        <div class="admin-modal-container" role="dialog" aria-modal="true" @click.outside="closeModal()">

            <!-- Modal Header -->
            <div class="admin-modal-header">
                <h3 class="admin-modal-title" x-text="isEdit ? 'Cập nhật sự kiện' : 'Tạo sự kiện mới'">
                </h3>
                <button type="button" class="admin-modal-close" @click="closeModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Toolbar is rendered from the editor component's single shared source. -->
            <div class="event-modal-toolbar" x-data="editorApp()"
                :class="{ 'is-no-field': !activeField, 'is-inline-field': activeField === 'title' || activeField === 'location' }"
                @mousedown.capture="captureSelection()" @click.capture="routeToolbarClick($event)">
                {% include "templates/components/editor/toolbar.j2" %}
            </div>

            <!-- Modal Body (Form) -->
            <form @submit.prevent="saveEvent()" @focusin="if (!$event.target.isContentEditable) activeField = null">
                <div class="admin-modal-body">
                    <!-- Event Name -->
                    <div class="admin-form-group">
                        <label>Tên sự kiện <span style="color: red;">*</span></label>
                        <div id="event-name" x-ref="titleEditor" contenteditable="true" role="textbox"
                            class="event-rich-input" data-placeholder="Ví dụ: Team Building Q2"
                            @focus="activateEditor('title', $el)" @keyup="captureSelection()"
                            @mouseup="captureSelection()" @keydown.enter.prevent @input="form.name = $el.innerHTML"
                            @blur="sanitizeInlineField('name', $el)">
                        </div>
                        <small class="event-field-error" x-show="errors.name" x-text="errors.name"></small>
                    </div>

                    <!-- Description -->
                    <div class="admin-form-group admin-desc-group">
                        <label>Mô tả</label>
                        <div id="event-desc" @focusin="activeField = 'description'; activeEditor = null">
                            {% with editor_hide_toolbar=true %}
                            {% include "templates/components/editor/editor.j2" %}
                            {% endwith %}
                        </div>
                        <small class="event-field-error" x-show="errors.description"
                            x-text="errors.description"></small>

                        <!-- Location -->
                        <div class="admin-form-group">
                            <label>Địa điểm</label>
                            <div class="admin-input-with-icon">
                                <span class="material-symbols-outlined">location_on</span>
                                <div id="event-location" x-ref="locationEditor" contenteditable="true" role="textbox"
                                    class="event-rich-input" data-placeholder="Ví dụ: Hội trường A / Online"
                                    @focus="activateEditor('location', $el)" @keyup="captureSelection()"
                                    @mouseup="captureSelection()" @keydown.enter.prevent
                                    @input="form.location = $el.innerHTML" @blur="sanitizeInlineField('location', $el)">
                                </div>
                            </div>
                            <small class="event-field-error" x-show="errors.location" x-text="errors.location"></small>
                        </div>

                        <!-- Start & End Date Time -->
                        <div class="admin-form-row">
                            <div class="admin-form-group">
                                <label for="event-start">Thời gian bắt đầu</label>
                                <input type="datetime-local" id="event-start" x-model="form.start_at"
                                    class="admin-form-input" @focus="activeField = null" />
                                <small class="event-field-error" x-show="errors.start_at"
                                    x-text="errors.start_at"></small>
                            </div>
                            <div class="admin-form-group">
                                <label for="event-end">Thời gian kết thúc</label>
                                <input type="datetime-local" id="event-end" x-model="form.end_at"
                                    class="admin-form-input" @focus="activeField = null" />
                                <small class="event-field-error" x-show="errors.end_at" x-text="errors.end_at"></small>
                            </div>
                        </div>
                    </div>

                    <!-- Link Google Maps -->
                    <div class="admin-form-group">
                        <label for="event-url-map">Link Google Maps</label>
                        <div class="admin-input-with-icon">
                            <span class="material-symbols-outlined">map</span>
                            <input type="url" id="event-url-map" x-model="form.url_map" class="admin-form-input"
                                placeholder="https://maps.google.com/?q=..." @focus="activeField = null" />
                        </div>
                        <small class="event-field-error" x-show="errors.url_map" x-text="errors.url_map"></small>
                    </div>

                    <!-- Event image -->
                    <div class="admin-form-group">
                        <label>Ảnh sự kiện</label>
                        <input x-ref="eventImage" type="file" hidden accept="image/jpeg,image/png"
                            @change="selectEventImage($event.target.files[0]); $event.target.value = ''">
                        <button type="button" class="event-use-media-btn" @click="openEventMediaPicker()">
                            <span class="material-symbols-outlined">perm_media</span>
                            Chọn ảnh từ Media
                        </button>
                        <small class="event-field-error" x-show="errors.image" x-text="errors.image"></small>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="admin-modal-footer">
                    <template x-if="isEdit">
                        <button type="button" class="btn-modal-danger" @click="deleteEvent()" :disabled="isLoading"
                            style="margin-right: auto;">
                            Xóa sự kiện
                        </button>
                    </template>

                    <button type="button" class="btn-modal-secondary" @click="closeModal()" :disabled="isLoading">
                        Hủy
                    </button>
                    <button type="submit" class="btn-modal-primary" :disabled="isLoading">
                        <div class="spinner-sm" x-show="isLoading"
                            style="display: none; border-top-color: var(--background);"></div>
                        <span x-text="isEdit ? 'Lưu thay đổi' : 'Tạo mới'"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}