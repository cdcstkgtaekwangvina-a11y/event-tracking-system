<!-- Tailwind CSS CDN and Config to prevent preflight reset -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: {
      preflight: false,
    }
  }
</script>

<div id="event-detail-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[99999] flex items-center justify-center p-4"
     x-show="isOpen"
     x-cloak
     style="display: none;"
     @keydown.escape.window="isOpen = false"
     @click.self="isOpen = false">
     
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-[640px] max-h-[90vh] flex flex-col overflow-y-auto relative shadow-2xl transition-all duration-300 transform"
         x-show="isOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
         
        <!-- Floating Close Button -->
        <button type="button" 
                class="absolute top-4 right-4 z-50 bg-slate-900/60 hover:bg-slate-900/80 text-white rounded-full p-2 flex items-center justify-center transition-all duration-200 backdrop-blur-sm cursor-pointer border-none outline-none" 
                @click="isOpen = false" 
                aria-label="Đóng">
            <span class="material-symbols-outlined text-[20px] font-bold">close</span>
        </button>

        <!-- Banner Image / Gradient Header -->
        <div :class="selectedEvent?.url_image ? 'relative w-full h-[280px] bg-center bg-no-repeat bg-cover flex-shrink-0' : 'relative w-full h-[280px] bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center flex-shrink-0'"
             :style="selectedEvent?.url_image ? 'background-image: url(' + selectedEvent.url_image + ')' : ''">
            
            <!-- Status Badge -->
            <span :class="selectedEvent?.status === 'ongoing' ? 'bg-emerald-500' : 'bg-teal-500'"
                  class="absolute top-4 left-4 px-3.5 py-1.5 rounded-full text-xs font-bold text-white shadow-md border-none"
                  x-text="selectedEvent?.status === 'ongoing' ? 'Đang diễn ra' : 'Sắp diễn ra'">
            </span>

            <!-- Placeholder icon when no image -->
            <span x-show="!selectedEvent?.url_image" class="material-symbols-outlined text-white/80 text-[72px]" x-cloak>
                calendar_today
            </span>
        </div>

        <!-- Modal Body -->
        <div class="p-6 sm:p-8 flex flex-col text-left">
            <!-- Event Title -->
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-5" x-text="selectedEvent?.name"></h2>

            {#
            === ĐOẠN CODE CŨ (Ngày tổ chức / Thời gian / Địa điểm hiển thị thành 3 ô riêng trong grid, comment lại để giữ tham khảo) ===
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">calendar_today</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Ngày tổ chức</span>
                        <span class="text-sm font-bold text-slate-800" x-text="selectedEvent?.start_at || 'Chưa xác định'"></span>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">schedule</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Thời gian</span>
                        <span class="text-sm font-bold text-slate-800" x-text="selectedEvent?.start_time || '00:00'"></span>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                    </div>
                    <div class="flex flex-col min-w-0 flex-1">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Địa điểm</span>
                        <span class="text-sm font-bold text-slate-800 break-words" x-text="selectedEvent?.location || 'Chưa xác định'"></span>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Người tham dự</span>
                        <span class="text-sm font-bold text-slate-800" x-text="(selectedEvent?.employee_count || 0) + ' người đã đăng ký'"></span>
                    </div>
                </div>
            </div>
            =======================================================================================
            #}
            <!-- Ngày/Giờ/Địa điểm được gộp vào khối Mô tả bên dưới; ở đây chỉ còn "Người tham dự" -->
            {#<div class="flex items-center gap-4 bg-slate-50 dark-surface border border-slate-100 dark-border p-3 px-4 rounded-xl mb-6">
                <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-[20px]">group</span>
                </div>
                <div class="flex flex-col min-w-0">
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 dark-label font-bold">Người tham dự</span>
                    <span class="text-sm font-bold text-slate-800 dark-strong" x-text="(selectedEvent?.employee_count || 0) + ' người đã đăng ký'"></span>
                </div>
            </div>

            <!-- Divider Line -->
            <hr class="border-0 border-t border-slate-100 dark-border mb-6">
            #}
            <!-- Description / Content (gộp chung Ngày tổ chức, Thời gian, Địa điểm vào đây) -->
            <div class="flex flex-col">
                <h3 class="text-lg font-extrabold text-slate-900 dark-strong mb-3">Mục tiêu & Nội dung</h3>

                <div class="event-meta-inline">
                    <span class="event-meta-chip">
                        <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                        <span x-text="selectedEvent?.start_at || 'Chưa xác định'"></span>
                    </span>
                    <span class="event-meta-chip">
                        <span class="material-symbols-outlined text-[18px]">schedule</span>
                        <span x-text="(selectedEvent?.start_time || '00:00') + ' - ' + (selectedEvent?.end_time || '00:00')"></span>
                    </span>
                    {#
                    === ĐOẠN CODE CŨ (tự tạo link Google Maps từ tên địa chỉ khi không có url_map -> comment lại):
                    === Không đúng ý: chỉ nên click được khi ADMIN thực sự nhập Link Google Maps (url_map).
                    === Nếu không nhập url_map thì không cho nhảy sang dù có tên địa chỉ.
                    <a class="event-meta-chip event-meta-link"
                       :href="selectedEvent?.url_map || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(selectedEvent?.location || ''))"
                       target="_blank" rel="noopener noreferrer"
                       @click="if (!selectedEvent?.url_map && !selectedEvent?.location) $event.preventDefault()">
                        <span class="material-symbols-outlined text-[18px]">location_on</span>
                        <span x-text="selectedEvent?.location || 'Chưa xác định'"></span>
                    </a>
                    =======================================================================================
                    #}
                    <!-- Chỉ click được (mở Google Maps) khi có url_map. Tên địa chỉ chỉ dùng để HIỂN THỊ:
                         có url_map + có tên -> hiện tên, bấm được; có url_map + không có tên -> không hiện
                         tên (chỉ icon), vẫn bấm được; không có url_map -> không phải link, không bấm được. -->
                    <template x-if="selectedEvent?.url_map">
                        <a class="event-meta-chip event-meta-link" :href="selectedEvent.url_map" target="_blank" rel="noopener noreferrer">
                            <span class="material-symbols-outlined text-[18px]">location_on</span>
                            <span x-text="selectedEvent?.location || ''"></span>
                        </a>
                    </template>
                    <template x-if="!selectedEvent?.url_map">
                        <span class="event-meta-chip">
                            <span class="material-symbols-outlined text-[18px]">location_on</span>
                            <span x-text="selectedEvent?.location || 'Chưa xác định'"></span>
                        </span>
                    </template>
                </div>

                <div class="text-sm sm:text-base text-slate-600 dark-muted leading-relaxed description-content"
                     x-html="selectedEvent?.description || '<p>Không có mô tả chi tiết cho sự kiện này.</p>'"></div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Các class "dark-*" + tuỳ biến bổ sung để modal chi tiết sự kiện theo đúng theme sáng/tối của app,
       thay cho màu Tailwind cứng (slate/white) không tự đổi theo data-theme.
       Chỉ override khi ở dark mode, giữ nguyên màu Tailwind gốc ở light mode. */
    :root[data-theme="dark"] #event-detail-modal .bg-white {
        background-color: var(--card);
    }
    :root[data-theme="dark"] #event-detail-modal .border-slate-200,
    :root[data-theme="dark"] #event-detail-modal .dark-border {
        border-color: var(--border);
    }
    :root[data-theme="dark"] #event-detail-modal .text-slate-900,
    :root[data-theme="dark"] #event-detail-modal .dark-strong {
        color: var(--foreground);
    }
    :root[data-theme="dark"] #event-detail-modal .dark-surface {
        background-color: var(--bg-home-page);
    }
    :root[data-theme="dark"] #event-detail-modal .dark-label {
        color: var(--text-secondary);
    }
    :root[data-theme="dark"] #event-detail-modal .dark-muted {
        color: var(--text-secondary);
    }

    .event-meta-inline {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
    }

    .event-meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--bg-home-page);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    .event-meta-link {
        color: var(--login-bg);
        text-decoration: none;
        cursor: pointer;
    }

    .event-meta-link:hover {
        text-decoration: underline;
    }
</style>
