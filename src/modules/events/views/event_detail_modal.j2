<!-- Tailwind CSS CDN and Config to prevent preflight reset -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: {
      preflight: false,
    }
  }
</script>

<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[99999] flex items-center justify-center p-4"
     x-show="isOpen"
     x-cloak
     style="display: none;"
     @keydown.escape.window="isOpen = false"
     @click.self="isOpen = false">
     
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-[640px] max-h-[90vh] flex flex-col overflow-y-auto relative shadow-2xl transition-all duration-300 transform"
         x-show="isOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
         
        <!-- Floating Close Button -->
        <button type="button" 
                class="absolute top-4 right-4 z-50 bg-slate-900/60 hover:bg-slate-900/80 text-white rounded-full p-2 flex items-center justify-center transition-all duration-200 backdrop-blur-sm cursor-pointer border-none outline-none" 
                @click="isOpen = false" 
                aria-label="Đóng">
            <span class="material-symbols-outlined text-[20px] font-bold">close</span>
        </button>

        <!-- Banner Image / Gradient Header -->
        <div :class="selectedEvent?.url_image ? 'relative w-full h-[280px] bg-center bg-no-repeat bg-cover flex-shrink-0' : 'relative w-full h-[280px] bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center flex-shrink-0'"
             :style="selectedEvent?.url_image ? 'background-image: url(' + selectedEvent.url_image + ')' : ''">
            
            <!-- Status Badge -->
            <span :class="selectedEvent?.status === 'ongoing' ? 'bg-emerald-500' : 'bg-teal-500'"
                  class="absolute top-4 left-4 px-3.5 py-1.5 rounded-full text-xs font-bold text-white shadow-md border-none"
                  x-text="selectedEvent?.status === 'ongoing' ? 'Đang diễn ra' : 'Sắp diễn ra'">
            </span>

            <!-- Placeholder icon when no image -->
            <span x-show="!selectedEvent?.url_image" class="material-symbols-outlined text-white/80 text-[72px]" x-cloak>
                calendar_today
            </span>
        </div>

        <!-- Modal Body -->
        <div class="p-6 sm:p-8 flex flex-col text-left">
            <!-- Event Title -->
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-5" x-text="selectedEvent?.name"></h2>

            <!-- Event Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <!-- Ngày tổ chức -->
                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">calendar_today</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Ngày tổ chức</span>
                        <span class="text-sm font-bold text-slate-800" x-text="selectedEvent?.start_at || 'Chưa xác định'"></span>
                    </div>
                </div>

                <!-- Thời gian -->
                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">schedule</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Thời gian</span>
                        <span class="text-sm font-bold text-slate-800" x-text="selectedEvent?.start_time || '00:00'"></span>
                    </div>
                </div>

                <!-- Địa điểm -->
                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                    </div>
                    <div class="flex flex-col min-w-0 flex-1">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Địa điểm</span>
                        <span class="text-sm font-bold text-slate-800 break-words" x-text="selectedEvent?.location || 'Chưa xác định'"></span>
                    </div>
                </div>

                <!-- Người tham dự -->
                <div class="flex items-center gap-4 bg-slate-50 border border-slate-100 p-3 px-4 rounded-xl">
                    <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Người tham dự</span>
                        <span class="text-sm font-bold text-slate-800" x-text="(selectedEvent?.employee_count || 0) + ' người đã đăng ký'"></span>
                    </div>
                </div>
            </div>

            <!-- Divider Line -->
            <hr class="border-0 border-t border-slate-100 mb-6">

            <!-- Description / Content -->
            <div class="flex flex-col">
                <h3 class="text-lg font-extrabold text-slate-900 mb-3">Mục tiêu & Nội dung</h3>
                <div class="text-sm sm:text-base text-slate-600 leading-relaxed description-content" 
                     x-html="selectedEvent?.description || '<p>Không có mô tả chi tiết cho sự kiện này.</p>'"></div>
            </div>
        </div>

    </div>
</div>
