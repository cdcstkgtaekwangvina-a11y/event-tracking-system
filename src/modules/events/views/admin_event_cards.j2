{% if events %}
<div class="admin-events-grid">
    {% set gradients = ['purple-blue', 'pink-red', 'green-teal', 'blue-dark', 'purple-pink', 'green-forest'] %}
    {% for event in events %}
        {% set grad_class = gradients[loop.index0 % 6] %}
        {# Calculate status based on now #}
        {% if event.start_at and event.end_at %}
            {% if now < event.start_at %}
                {% set status_text = "Sắp diễn ra" %}
                {% set status_class = "status-upcoming" %}
            {% elif now >= event.start_at and now <= event.end_at %}
                {% set status_text = "Đang diễn ra" %}
                {% set status_class = "status-ongoing" %}
            {% else %}
                {% set status_text = "Đã kết thúc" %}
                {% set status_class = "status-ended" %}
            {% endif %}
        {% else %}
            {% set status_text = "Sắp diễn ra" %}
            {% set status_class = "status-upcoming" %}
        {% endif %}

        <div class="admin-event-card">
            {#
            === ĐOẠN CODE CŨ (không có ảnh thì bỏ trống hẳn khối ảnh -> comment lại để giữ tham khảo):
            === LỖI: card không có ảnh bị thấp hơn card có ảnh; CSS Grid mặc định kéo dãn các card cùng dòng
            === bằng chiều cao nhau (theo card cao nhất), nên card không ảnh bị dư khoảng trắng lớn, không
            === đồng nhất giao diện giữa các card trong cùng 1 dòng.
            {% if event.url_image %}
            <div class="admin-card-image" style="height: 160px; background: url('{{ event.url_image }}') no-repeat center center/cover; margin: -24px -24px 0 -24px; border-radius: 11px 11px 0 0;"></div>
            {% endif %}
            =======================================================================================
            #}
            <!-- Card ảnh: giữ nguyên chiều cao đồng nhất bằng khối gradient + icon thay thế khi không có ảnh
                 (giống cách card bên trang home xử lý) -->
            {% if event.url_image %}
            <div class="admin-card-image" style="height: 160px; background: url('{{ event.url_image }}') no-repeat center center/cover; margin: -24px -24px 0 -24px; border-radius: 11px 11px 0 0;"></div>
            {% else %}
            <div class="admin-card-image admin-card-image-placeholder {{ grad_class }}" style="margin: -24px -24px 0 -24px; border-radius: 11px 11px 0 0;">
                <span class="material-symbols-outlined">calendar_today</span>
            </div>
            {% endif %}
            <!-- Card Header: Title & Status -->
            <div class="admin-card-header">
                <h3 class="admin-event-title" title="{{ event.name }}">{{ event.name }}</h3>
                <span class="status-badge {{ status_class }}">{{ status_text }}</span>
            </div>

            {#
            === ĐOẠN CODE CŨ (Ngày/Giờ/Địa điểm hiển thị thành 3 dòng riêng biệt, comment lại để giữ tham khảo) ===
            <div class="admin-card-body">
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">calendar_today</span>
                    <span>{{ event.start_at.strftime('%Y-%m-%d') if event.start_at else 'Chưa xác định' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">schedule</span>
                    <span>{{ event.start_at.strftime('%H:%M') if event.start_at else '00:00' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">location_on</span>
                    <span>{{ event.location or 'Chưa xác định' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">group</span>
                    <span>{{ event.employee_count or 0 }} người tham gia</span>
                </div>
            </div>
            =======================================================================================
            #}
            {#
            === ĐOẠN CODE CŨ (Ngày/Giờ/Địa điểm gộp 1 dòng nhưng vẫn là 1 admin-info-item riêng, chưa nằm
            === trong khối Mô tả -> comment lại để giữ tham khảo) ===
            <div class="admin-card-body">
                <div class="admin-info-item admin-meta-line">
                    <span class="material-symbols-outlined">calendar_today</span>
                    <span>
                        {{ event.start_at.strftime('%d/%m/%Y') if event.start_at else 'Chưa xác định' }}
                        {% if event.start_at %}· {{ event.start_at.strftime('%H:%M') }}{% endif %}
                        {% if event.location %}· {{ event.location }}{% endif %}
                    </span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">group</span>
                    <span>{{ event.employee_count or 0 }} người tham gia</span>
                </div>
            </div>
            =======================================================================================
            #}
            <!-- Card Body: Ngày/Giờ/Địa điểm nằm chung trong khối Mô tả (giống card bên home),
                 "Người tham gia" giữ riêng -->
            <div class="admin-card-body">
                <div class="admin-desc-block">
                    {#
                    === ĐOẠN CODE CŨ (ngày/giờ/địa điểm dùng chung 1 icon lịch, không có icon riêng cho địa điểm) ===
                    <p class="admin-meta-line">
                        <span class="material-symbols-outlined">calendar_today</span>
                        <span>
                            {{ event.start_at.strftime('%d/%m/%Y') if event.start_at else 'Chưa xác định' }}
                            {% if event.start_at %}· {{ event.start_at.strftime('%H:%M') }}{% endif %}
                            {% if event.location %}· {{ event.location }}{% endif %}
                        </span>
                    </p>
                    =======================================================================================
                    #}
                    <!-- Địa điểm có icon riêng (location_on) để dễ hình dung đâu là địa chỉ -->
                    <p class="admin-meta-line">
                        <span class="admin-meta-item">
                            <span class="material-symbols-outlined">calendar_today</span>
                            <span>
                                {{ event.start_at.strftime('%d/%m/%Y') if event.start_at else 'Chưa xác định' }}
                                {% if event.start_at %}· {{ event.start_at.strftime('%H:%M') }}{% endif %}
                            </span>
                        </span>
                        {% if event.location %}
                        <span class="admin-meta-item">
                            <span class="material-symbols-outlined">location_on</span>
                            <span>{{ event.location }}</span>
                        </span>
                        {% endif %}
                    </p>
                    {#
                    === ĐOẠN CODE CŨ (kiểm tra rỗng trên chuỗi HTML gốc "event.description or ..." -> comment lại):
                    === LỖI: TipTap lưu mô tả trống thành "<p></p>" (chuỗi không rỗng), nên "or 'Chưa có mô tả'"
                    === không chạy, sau đó striptags xoá tag để lại chuỗi rỗng thật -> hiện dòng trống, không
                    === phải chữ "Chưa có mô tả" như mong đợi.
                    <p class="admin-event-desc" title="{{ (event.description or '') | striptags | forceescape }}">{{ (event.description or 'Chưa có mô tả') | striptags }}</p>
                    =======================================================================================
                    #}
                    {% set admin_desc_text = (event.description or '') | striptags | trim %}
                    <p class="admin-event-desc" title="{{ admin_desc_text | forceescape }}">{{ admin_desc_text or 'Chưa có mô tả' }}</p>
                </div>
                {#<div class="admin-info-item">
                    <span class="material-symbols-outlined">group</span>
                    <span>{{ event.employee_count or 0 }} người tham gia</span>
                </div>#}
            </div>

            <div class="admin-card-divider"></div>

            <!-- Card Footer: Action -->
            <div class="admin-card-footer">
                {#
                === ĐOẠN CODE CŨ (build chuỗi JS bằng nháy đơn + filter "escape", comment lại để giữ tham khảo) ===
                === LỖI: escape chỉ đổi ' thành &#39;, nhưng browser tự decode HTML-entity của attribute
                === TRƯỚC khi Alpine đọc JS, nên &#39; lại thành ' thật -> đóng chuỗi JS sớm nếu name/description/
                === location chứa dấu nháy đơn -> $dispatch lỗi cú pháp, "Xem chi tiết" không mở được modal. ===
                <button type="button" class="btn-view-details"
                    @click="$dispatch('open-edit-modal', {
                        id: {{ event.id }},
                        name: '{{ event.name | escape }}',
                        description: '{{ (event.description or "") | escape }}',
                        start_at: '{{ event.start_at.isoformat() if event.start_at else "" }}',
                        end_at: '{{ event.end_at.isoformat() if event.end_at else "" }}',
                        location: '{{ (event.location or "") | escape }}',
                        url_image: '{{ (event.url_image or "") | escape }}',
                        url_map: '{{ (event.url_map or "") | escape }}'
                    })">
                    Xem chi tiết
                </button>
                =======================================================================================
                #}
                <!-- Dùng tojson | forceescape (giống event_cards.j2 bên home) để escape đúng cho mọi ký tự
                     đặc biệt (', ", \, xuống dòng...) trong name/description/location, không bị vỡ cú pháp JS -->
                <a href="/admin/events/{{ event.id }}" hx-get="/admin/events/{{ event.id }}" hx-target="#admin-main-content" hx-push-url="true" class="btn-view-details">
                    Xem chi tiết
                </a>
                <button type="button" class="btn-edit-card" title="Chỉnh sửa nhanh"
                    @click="$dispatch('open-edit-modal', {
                        id: {{ event.id }},
                        name: {{ event.name | tojson | forceescape }},
                        description: {{ (event.description or '') | tojson | forceescape }},
                        start_at: {{ (event.start_at.isoformat() if event.start_at else '') | tojson | forceescape }},
                        end_at: {{ (event.end_at.isoformat() if event.end_at else '') | tojson | forceescape }},
                        location: {{ (event.location or '') | tojson | forceescape }},
                        url_image: {{ (event.url_image or '') | tojson | forceescape }},
                        url_map: {{ (event.url_map or '') | tojson | forceescape }}
                    })">
                    <span class="material-symbols-outlined">edit</span>
                </button>
                <button type="button" class="btn-delete-card" title="Xóa sự kiện"
                    @click="$dispatch('delete-event', { id: {{ event.id }}, name: {{ event.name | tojson | forceescape }} })">
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </div>
        </div>
    {% endfor %}
</div>

{% if total_pages > 1 %}
<div class="admin-pagination">
    <button type="button" class="admin-page-btn" {% if page > 1 %}
        hx-get="/api/events/admin-cards-html?page={{ page - 1 }}&limit={{ limit }}&search={{ search }}&status={{ status }}&sort_field={{ sort_field }}&is_desc={{ is_desc }}"
        hx-target="#admin-events-container"
        hx-swap="innerHTML"
        {% else %}
        disabled
        {% endif %}>
        <span class="material-symbols-outlined">chevron_left</span>
    </button>

    <span class="admin-page-info">Trang <b>{{ page }}</b> / {{ total_pages }}</span>

    <button type="button" class="admin-page-btn" {% if page < total_pages %}
        hx-get="/api/events/admin-cards-html?page={{ page + 1 }}&limit={{ limit }}&search={{ search }}&status={{ status }}&sort_field={{ sort_field }}&is_desc={{ is_desc }}"
        hx-target="#admin-events-container"
        hx-swap="innerHTML" {% else %} disabled {% endif %}>
        <span class="material-symbols-outlined">chevron_right</span>
    </button>
</div>
{% endif %}

{% else %}
<div class="admin-no-events">
    <span class="material-symbols-outlined icon-huge">event_busy</span>
    <h3>Không tìm thấy sự kiện nào</h3>
    <p>Hãy tạo sự kiện mới hoặc thử tìm kiếm với từ khóa khác.</p>
</div>
{% endif %}
