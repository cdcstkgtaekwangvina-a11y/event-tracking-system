{% if events %}
<div class="admin-events-grid">
    {% for event in events %}
        {# Calculate status based on now #}
        {% if event.start_at and event.end_at %}
            {% if now < event.start_at %}
                {% set status_text = "Sắp diễn ra" %}
                {% set status_class = "status-upcoming" %}
            {% elif now >= event.start_at and now <= event.end_at %}
                {% set status_text = "Đang diễn ra" %}
                {% set status_class = "status-ongoing" %}
            {% else %}
                {% set status_text = "Đã kết thúc" %}
                {% set status_class = "status-ended" %}
            {% endif %}
        {% else %}
            {% set status_text = "Sắp diễn ra" %}
            {% set status_class = "status-upcoming" %}
        {% endif %}

        <div class="admin-event-card">
            <!-- Card Header: Title & Status -->
            <div class="admin-card-header">
                <h3 class="admin-event-title" title="{{ event.name }}">{{ event.name }}</h3>
                <span class="status-badge {{ status_class }}">{{ status_text }}</span>
            </div>

            <!-- Card Body: Details -->
            <div class="admin-card-body">
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">calendar_today</span>
                    <span>{{ event.start_at.strftime('%Y-%m-%d') if event.start_at else 'Chưa xác định' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">schedule</span>
                    <span>{{ event.start_at.strftime('%H:%M') if event.start_at else '00:00' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">location_on</span>
                    <span>{{ event.location or 'Chưa xác định' }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="material-symbols-outlined">group</span>
                    <span>{{ event.employee_count or 0 }} người tham gia</span>
                </div>
            </div>

            <div class="admin-card-divider"></div>

            <!-- Card Footer: Action -->
            <div class="admin-card-footer">
                <button type="button" class="btn-view-details" 
                    @click="$dispatch('open-edit-modal', {
                        id: {{ event.id }},
                        name: '{{ event.name | escape }}',
                        description: '{{ (event.description or "") | escape }}',
                        start_at: '{{ event.start_at.isoformat() if event.start_at else "" }}',
                        end_at: '{{ event.end_at.isoformat() if event.end_at else "" }}',
                        location: '{{ (event.location or "") | escape }}',
                        url_image: '{{ (event.url_image or "") | escape }}',
                        url_map: '{{ (event.url_map or "") | escape }}'
                    })">
                    Xem chi tiết
                </button>
            </div>
        </div>
    {% endfor %}
</div>

{% if total_pages > 1 %}
<div class="admin-pagination">
    <button type="button" class="admin-page-btn" {% if page > 1 %}
        hx-get="/api/events/admin-cards-html?page={{ page - 1 }}&limit={{ limit }}&search={{ search }}&status={{ status }}&sort_field={{ sort_field }}&is_desc={{ is_desc }}"
        hx-target="#admin-events-container"
        hx-swap="innerHTML"
        {% else %}
        disabled
        {% endif %}>
        <span class="material-symbols-outlined">chevron_left</span>
    </button>

    <span class="admin-page-info">Trang <b>{{ page }}</b> / {{ total_pages }}</span>

    <button type="button" class="admin-page-btn" {% if page < total_pages %}
        hx-get="/api/events/admin-cards-html?page={{ page + 1 }}&limit={{ limit }}&search={{ search }}&status={{ status }}&sort_field={{ sort_field }}&is_desc={{ is_desc }}"
        hx-target="#admin-events-container"
        hx-swap="innerHTML" {% else %} disabled {% endif %}>
        <span class="material-symbols-outlined">chevron_right</span>
    </button>
</div>
{% endif %}

{% else %}
<div class="admin-no-events">
    <span class="material-symbols-outlined icon-huge">event_busy</span>
    <h3>Không tìm thấy sự kiện nào</h3>
    <p>Hãy tạo sự kiện mới hoặc thử tìm kiếm với từ khóa khác.</p>
</div>
{% endif %}
