        font-size: 42px;
        opacity: 0.6;
    }

    .attendees-empty h4 {
        margin: 0;
        font-size: 15px;
        color: var(--foreground);
    }

    .attendees-empty p {
        margin: 0;
        font-size: 13.5px;
    }

