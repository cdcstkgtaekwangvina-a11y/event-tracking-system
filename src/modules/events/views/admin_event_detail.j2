    .featured-image-img {
        width: 100%;
        height: 280px;
        object-fit: cover;
        display: block;
    }

    .featured-image-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 12px 16px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
