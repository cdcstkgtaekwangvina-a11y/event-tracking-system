        border-color: var(--foreground);
    }

    .placeholder-icon {
        font-size: 48px;
        color: var(--text-secondary);
        opacity: 0.6;
    }

    .featured-image-empty-placeholder p {
        margin: 0;
        font-size: 14px;
        color: var(--text-secondary);
    }

