        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 6px;
    }

    .attendees-page-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--foreground);
