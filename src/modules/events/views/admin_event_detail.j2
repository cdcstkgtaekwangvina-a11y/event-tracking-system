        font-weight: 700;
        font-size: 13px;
        padding: 2px 4px;
        margin: 0 4px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        -moz-appearance: textfield;
