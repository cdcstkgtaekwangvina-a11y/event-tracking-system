    .detail-featured-image-box {
        margin-top: 10px;
        padding: 20px;
        border: 1px dashed var(--border);
        border-radius: 12px;
        background: var(--bg-home-page);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .featured-image-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 700;
        color: var(--foreground);
        margin: 0;
    }

    .featured-image-title .material-symbols-outlined {
        font-size: 20px;
        color: var(--text-secondary);
    }

    .featured-image-container {
        width: 100%;
    }

    .featured-image-preview-wrapper {
        position: relative;
        width: 100%;
        max-height: 320px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: #000;
