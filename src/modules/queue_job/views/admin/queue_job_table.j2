<!-- Loading state -->
<template x-if="loading && jobs.length === 0">
    <div class="qj-empty">
        <div style="width:36px;height:36px;border:3px solid rgba(7,163,158,0.2);border-top-color:#07A39E;border-radius:50%;animation:qjSpin 0.8s linear infinite;margin:0 auto 12px;"></div>
        <p class="qj-empty-title">Đang tải danh sách công việc...</p>
    </div>
</template>

<!-- Jobs list -->
<template x-if="!loading || jobs.length > 0">
    <div>
        <template x-if="jobs && jobs.length > 0">
            <div>
                <table class="qj-table">
                    <thead>
                        <tr>
                            <th class="qj-th qj-th-sort" :class="{ 'qj-th-sort--active': isSortActive('id') }"
                                @click="toggleSort('id')" title="Sắp xếp theo Job ID">
                                <span class="qj-th-label">Job ID</span>
                                <span class="material-symbols-outlined qj-sort-icon" :class="{ 'qj-sort-icon--idle': !isSortActive('id') }" x-text="sortIcon('id')"></span>
                            </th>
                            <th class="qj-th qj-th-sort" :class="{ 'qj-th-sort--active': isSortActive('type') }"
                                @click="toggleSort('type')" title="Sắp xếp theo Loại công việc">
                                <span class="qj-th-label">Loại công việc</span>
                                <span class="material-symbols-outlined qj-sort-icon" :class="{ 'qj-sort-icon--idle': !isSortActive('type') }" x-text="sortIcon('type')"></span>
                            </th>
                            <th class="qj-th qj-th-sort" :class="{ 'qj-th-sort--active': isSortActive('status') }"
                                @click="toggleSort('status')" title="Sắp xếp theo Trạng thái">
                                <span class="qj-th-label">Trạng thái</span>
                                <span class="material-symbols-outlined qj-sort-icon" :class="{ 'qj-sort-icon--idle': !isSortActive('status') }" x-text="sortIcon('status')"></span>
                            </th>
                            <th class="qj-th">Tiến độ</th>
                            <th class="qj-th qj-th-sort" :class="{ 'qj-th-sort--active': isSortActive('created_at') }"
                                @click="toggleSort('created_at')" title="Sắp xếp theo Thời gian tạo">
                                <span class="qj-th-label">Thời gian tạo</span>
                                <span class="material-symbols-outlined qj-sort-icon" :class="{ 'qj-sort-icon--idle': !isSortActive('created_at') }" x-text="sortIcon('created_at')"></span>
                            </th>
                            <th class="qj-th qj-th-sort" :class="{ 'qj-th-sort--active': isSortActive('finished_at') }"
                                @click="toggleSort('finished_at')" title="Sắp xếp theo Hoàn thành">
                                <span class="qj-th-label">Hoàn thành</span>
                                <span class="material-symbols-outlined qj-sort-icon" :class="{ 'qj-sort-icon--idle': !isSortActive('finished_at') }" x-text="sortIcon('finished_at')"></span>
                            </th>
                            <th class="qj-th qj-th-action">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="job in jobs" :key="job.id">
                            <tr class="qj-tr">
                                <td class="qj-td qj-td-id" :title="job.id">
                                    <span class="qj-id-text" x-text="String(job.id).substring(0, 13) + '...'"></span>
                                </td>
                                <td class="qj-td">
                                    <span class="qj-type-badge" x-text="getJobTypeLabel(job.type)"></span>
                                </td>
                                <td class="qj-td">
                                    <template x-if="job.status === 'running'">
                                        <span class="qj-status qj-status-running">
                                            <span class="qj-status-dot"></span> Đang chạy
                                        </span>
                                    </template>
                                    <template x-if="job.status === 'success'">
                                        <span class="qj-status qj-status-success">
                                            <span class="material-symbols-outlined qj-status-icon">check_circle</span> Thành công
                                        </span>
                                    </template>
                                    <template x-if="job.status === 'failed'">
                                        <span class="qj-status qj-status-failed">
                                            <span class="material-symbols-outlined qj-status-icon">cancel</span> Thất bại
                                        </span>
                                    </template>
                                    <template x-if="job.status === 'cancelled'">
                                        <span class="qj-status qj-status-cancelled">
                                            <span class="material-symbols-outlined qj-status-icon">block</span> Đã huỷ
                                        </span>
                                    </template>
                                    <template x-if="!['running','success','failed','cancelled'].includes(job.status)">
                                        <span class="qj-status qj-status-pending">
                                            <span class="qj-status-dot"></span> <span x-text="job.status"></span>
                                        </span>
                                    </template>
                                </td>
                                <td class="qj-td">
                                    <div class="qj-progress-wrapper">
                                        <div class="qj-progress-bar">
                                            <div class="qj-progress-fill" :style="`width: ${job.progress || 0}%;`"></div>
                                        </div>
                                        <span class="qj-progress-text" x-text="`${job.progress || 0}%`"></span>
                                    </div>
                                </td>
                                <td class="qj-td qj-td-time" x-text="formatDate(job.created_at)"></td>
                                <td class="qj-td qj-td-time" x-text="formatDate(job.finished_at)"></td>
                                <td class="qj-td qj-td-action">
                                    <button type="button"
                                            class="qj-action-btn"
                                            title="Xem chi tiết"
                                            @click="showDetail(job)">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>

                <!-- Pagination -->
                <template x-if="total > limit">
                    <div class="qj-pagination">
                        <button class="qj-page-btn"
                                :disabled="page <= 1"
                                @click="fetchJobs(1)"
                                title="Trang đầu">
                            <span class="material-symbols-outlined">first_page</span>
                        </button>
                        <button class="qj-page-btn"
                                :disabled="page <= 1"
                                @click="fetchJobs(page - 1)"
                                title="Trang trước">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </button>

                        <span class="qj-page-info" x-text="`${page} / ${Math.ceil(total / limit)}`"></span>

                        <button class="qj-page-btn"
                                :disabled="page >= Math.ceil(total / limit)"
                                @click="fetchJobs(page + 1)"
                                title="Trang sau">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </button>
                        <button class="qj-page-btn"
                                :disabled="page >= Math.ceil(total / limit)"
                                @click="fetchJobs(Math.ceil(total / limit))"
                                title="Trang cuối">
                            <span class="material-symbols-outlined">last_page</span>
                        </button>
                    </div>
                </template>
            </div>
        </template>

        <!-- Empty state -->
        <template x-if="!loading && (!jobs || jobs.length === 0)">
            <div class="qj-empty">
                <span class="material-symbols-outlined qj-empty-icon">inbox</span>
                <p class="qj-empty-title">Không tìm thấy công việc nào</p>
                <p class="qj-empty-sub">Hãy thử thay đổi từ khoá tìm kiếm hoặc bộ lọc trạng thái</p>
            </div>
        </template>
    </div>
</template>
