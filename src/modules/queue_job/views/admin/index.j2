{% extends "templates/layouts/admin.j2" if not request.headers.get("hx-request") else "templates/layouts/admin_blank.j2" %}
{% block admin_title %}Quản lý Queue Jobs{% endblock %}

{% block admin_body %}
<script>
(function() {
    window.mapJob = {
        "bulk_upsert_employees_task": "Import khách mời",
    };
    window.reverseMapJob = Object.fromEntries(
        Object.entries(window.mapJob).map(([k, v]) => [v.toLowerCase(), k])
    );

    function registerQueueJobsApp() {
        if (!window.Alpine) return;

        Alpine.data('queueJobsApp', () => ({
            jobs: [],
            total: 0,
            page: 1,
            limit: 10,
            currentStatus: '{{ status_filter or "all" }}',
            searchQuery: '{{ search or "" }}',
            sortField: 'created_at',
            isDesc: true,
            loading: false,

            async initData() {
                await this.fetchJobs();
            },

            async fetchJobs(newPage = 1) {
                this.loading = true;
                this.page = newPage;
                try {
                    while (!window.fetchHelper) {
                        await new Promise(r => setTimeout(r, 50));
                    }

                    const params = {
                        page: this.page,
                        limit: this.limit,
                        sort_field: this.sortField,
                        is_desc: this.isDesc
                    };
                    if (this.currentStatus && this.currentStatus !== 'all') {
                        params.status = this.currentStatus;
                    }
                    if (this.searchQuery && this.searchQuery.trim()) {
                        params.search = this.resolveSearch(this.searchQuery.trim());
                    }

                    const res = await window.fetchHelper.get('queue-jobs', params);
                    if (res && res.status_code === 200 && res.data) {
                        this.jobs = res.data.data || [];
                        this.total = res.data.total_items || res.data.total || 0;
                    } else if (res && res.data) {
                        this.jobs = res.data.data || res.data || [];
                        this.total = res.total_items || res.total || this.jobs.length;
                    } else if (Array.isArray(res)) {
                        this.jobs = res;
                        this.total = res.length;
                    }
                } catch (e) {
                    console.error("Lỗi khi gọi API Queue Jobs:", e);
                } finally {
                    this.loading = false;
                }
            },

            setStatus(status) {
                this.currentStatus = status;
                this.fetchJobs(1);
            },

            getJobTypeLabel(type) {
                if (!type) return '—';
                const map = window.mapJob || {};
                return map[type] || type;
            },

            resolveSearch(query) {
                const rmap = window.reverseMapJob || {};
                const lowerQuery = query.toLowerCase();
                for (const [label, dbKey] of Object.entries(rmap)) {
                    if (label.includes(lowerQuery) || lowerQuery.includes(label)) {
                        return dbKey;
                    }
                }
                return query;
            },

            toggleSort(field) {
                if (this.sortField === field) {
                    this.isDesc = !this.isDesc;
                } else {
                    this.sortField = field;
                    this.isDesc = true;
                }
                this.fetchJobs(1);
            },

            sortIcon(field) {
                if (this.sortField !== field) return 'unfold_more';
                return this.isDesc ? 'arrow_downward' : 'arrow_upward';
            },

            isSortActive(field) {
                return this.sortField === field;
            },

            formatDate(dateStr) {
                if (!dateStr) return '—';
                try {
                    const d = new Date(dateStr);
                    if (isNaN(d.getTime())) return String(dateStr);
                    const day = String(d.getDate()).padStart(2, '0');
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const year = d.getFullYear();
                    const hours = String(d.getHours()).padStart(2, '0');
                    const minutes = String(d.getMinutes()).padStart(2, '0');
                    const seconds = String(d.getSeconds()).padStart(2, '0');
                    return `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
                } catch (e) {
                    return String(dateStr);
                }
            },

            showDetail(job) {
                window.queueJobDetailModal?.open(job);
            }
        }));
    }

    if (window.Alpine) {
        registerQueueJobsApp();
    } else {
        document.addEventListener('alpine:init', registerQueueJobsApp);
    }
})();
</script>

<div class="qj-container" x-data="queueJobsApp()" x-init="initData()">
    <!-- Header -->
    <div class="qj-header">
        <div>
            <h1 class="qj-title">Quản lý Queue Jobs</h1>
            <p class="qj-sub">Theo dõi các tiến trình xử lý ngầm (Import nhân viên, xử lý hàng loạt...)</p>
        </div>
        <div class="qj-header-actions">
            <button type="button" class="qj-btn qj-btn-secondary" @click="fetchJobs(1)" :disabled="loading">
                <span class="material-symbols-outlined" :class="{ 'qj-spin': loading }">refresh</span>
                Làm mới
            </button>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="qj-toolbar">
        <div class="qj-status-tabs">
            <button type="button" class="qj-status-tab" :class="{ 'qj-status-tab--active': currentStatus === 'all' }"
                @click="setStatus('all')">
                Tất cả
            </button>
            <button type="button" class="qj-status-tab"
                :class="{ 'qj-status-tab--active': currentStatus === 'running' }" @click="setStatus('running')">
                Đang chạy
            </button>
            <button type="button" class="qj-status-tab"
                :class="{ 'qj-status-tab--active': currentStatus === 'success' }" @click="setStatus('success')">
                Thành công
            </button>
            <button type="button" class="qj-status-tab" :class="{ 'qj-status-tab--active': currentStatus === 'failed' }"
                @click="setStatus('failed')">
                Thất bại
            </button>
        </div>

        <div class="qj-search-box">
            <label for="qj-search-input" class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;">Tìm kiếm công việc</label>
            <span class="material-symbols-outlined qj-search-icon">search</span>
            <input type="text" id="qj-search-input" name="search" class="qj-search-input" placeholder="Tìm kiếm công việc (nhập từ khóa)..."
                x-model="searchQuery" @keydown.enter="fetchJobs(1)" aria-label="Tìm kiếm công việc" />
        </div>
    </div>

    <!-- Table Container -->
    <div class="qj-table-wrapper">
        <div id="qj-table-container">
            {% include "modules/queue_job/views/admin/queue_job_table.j2" %}
        </div>
    </div>
</div>

{% include "modules/queue_job/views/admin/queue_job_detail_modal.j2" %}

<link rel="stylesheet" href="/static/css/queue_jobs.css">
{% endblock %}