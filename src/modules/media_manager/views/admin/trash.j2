{% extends "templates/layouts/admin.j2" %}
{% block admin_title %}Thùng rác{% endblock %}
{% block admin_body %}
<div x-data="{
        hasData: true,
        viewMode: localStorage.getItem('mediaViewMode') || 'grid',
        init() {
            this.$watch('viewMode', val => localStorage.setItem('mediaViewMode', val));
        }
    }" @view-mode-changed.window="viewMode = $event.detail.mode">
    {% include "modules/media_manager/views/admin/header.j2" %}
    <div class="media-body" id="media-items-container"
        hx-get="{{ url_for('media_manager') }}/items/html?deleted_media=true" hx-trigger="load" hx-swap="innerHTML">
        <div class="media-loading">
            <div class="spinner-sm"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    </div>
</div>
<style>
    .media-body {
        background-color: var(--background);
        margin-right: 8px;
        margin-left: 8px;
        min-height: 320px;
        overflow-y: auto;
        padding: 5px;

        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: max-content;
        gap: 16px;
        align-content: start;
    }
</style>
{% endblock %}