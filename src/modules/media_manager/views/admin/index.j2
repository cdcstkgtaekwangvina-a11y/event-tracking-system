{% extends "templates/layouts/admin.j2" if not request.headers.get("hx-request") else
"templates/layouts/admin_blank.j2"%}
{% block admin_title %}Quản lý File{% endblock %}
{% block admin_body %}
<div x-data="{ hasData: true, viewMode: localStorage.getItem('mediaViewMode') || 'grid', init() { this.$watch('viewMode', val => localStorage.setItem('mediaViewMode', val)) } }"
    @view-mode-changed.window="viewMode = $event.detail.mode">
    {% include "modules/media_manager/views/admin/header.j2" %}
    <div class="media-body" id="media-items-container" x-init="window.mediaActions?.initMarqueeSelection?.($el)"
        hx-get="{{ url_for('media_manager') }}/items/html?{{ request.query_params }}" hx-trigger="load"
        hx-swap="innerHTML">
        <div class="media-loading">
            <div class="spinner-sm"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    </div>
</div>

<style>
    .media-body {
        background-color: var(--background);
        margin-right: 8px;
        margin-left: 8px;
        min-height: 320px;
        overflow-y: auto;
        padding: 5px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 16px;

        /* Custom scrollbar */
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

    /* Webkit scrollbar for media-body */
    .media-body::-webkit-scrollbar {
        width: 6px;
    }

    .media-body::-webkit-scrollbar-track {
        background: transparent;
        border-radius: 999px;
    }

    .media-body::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 999px;
        transition: background 0.2s ease;
    }

    .media-body::-webkit-scrollbar-thumb:hover {
        background: var(--text-secondary);
    }


    .media-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 60px 20px;
        color: var(--text-secondary);
        font-size: 14px;
        grid-column: 1 / -1;
    }

    .spinner-sm {
        width: 18px;
        height: 18px;
        border: 2.5px solid var(--border);
        border-top-color: var(--foreground);
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
{% endblock %}
