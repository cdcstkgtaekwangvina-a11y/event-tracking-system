{# Grid view items #}
{% if items %}
    {% for item in items %}
    <article class="media-item media-grid-item"
             data-id="{{ item.id }}"
             data-type="{{ item.type }}"
             data-url="{{ item.url if item.type == 'file' else '' }}"
             data-name="{{ item.name }}"
             data-folder-id="{{ item.folder_id if item.type == 'file' else item.parent_id }}"
             role="listitem">
        <div class="media-thumbnail">
            {% if item.type == 'file' %}
                {% set file_type = item.file_type|lower %}
                {% if file_type.startswith('image/') %}
                    <img src="{{ item.url }}" alt="{{ item.name }}" loading="lazy">
                {% elif file_type.startswith('video/') %}
                    <video src="{{ item.url }}" muted preload="metadata" poster="">
                        <span class="material-symbols-outlined video-icon">videocam</span>
                    </video>
                {% elif file_type.startswith('audio/') %}
                    <div class="audio-placeholder">
                        <span class="material-symbols-outlined">audiotrack</span>
                    </div>
                {% elif file_type == 'application/pdf' %}
                    <div class="pdf-placeholder">
                        <span class="material-symbols-outlined">picture_as_pdf</span>
                    </div>
                {% elif file_type.startswith('application/') and ('word' in file_type or 'document' in file_type) %}
                    <div class="doc-placeholder">
                        <span class="material-symbols-outlined">description</span>
                    </div>
                {% elif file_type.startswith('application/') and ('sheet' in file_type or 'excel' in file_type) %}
                    <div class="xls-placeholder">
                        <span class="material-symbols-outlined">table_chart</span>
                    </div>
                {% elif file_type.startswith('application/') and ('presentation' in file_type or 'powerpoint' in file_type) %}
                    <div class="ppt-placeholder">
                        <span class="material-symbols-outlined">slideshow</span>
                    </div>
                {% elif file_type.startswith('text/') %}
                    <div class="txt-placeholder">
                        <span class="material-symbols-outlined">text_snippet</span>
                    </div>
                {% elif file_type in ['application/zip', 'application/x-zip-compressed', 'application/x-rar-compressed', 'application/x-7z-compressed'] %}
                    <div class="archive-placeholder">
                        <span class="material-symbols-outlined">archive</span>
                    </div>
                {% else %}
                    <div class="file-placeholder">
                        <span class="material-symbols-outlined">insert_drive_file</span>
                    </div>
                {% endif %}
            {% else %}
                <div class="folder-placeholder">
                    <span class="material-symbols-outlined">folder</span>
                </div>
            {% endif %}
        </div>

        <div class="media-overlay">
            {% if item.type == 'file' %}
            <button type="button" class="overlay-btn preview-btn" aria-label="Xem trước: {{ item.name }}" title="Xem trước">
                <span class="material-symbols-outlined">visibility</span>
            </button>
            <button type="button" class="overlay-btn download-btn" aria-label="Tải xuống: {{ item.name }}" title="Tải xuống" data-url="{{ item.url }}">
                <span class="material-symbols-outlined">download</span>
            </button>
            {% endif %}
            <button type="button" class="overlay-btn rename-btn" aria-label="Đổi tên: {{ item.name }}" title="Đổi tên">
                <span class="material-symbols-outlined">edit</span>
            </button>
            {% if item.type == 'folder' %}
            <button type="button" class="overlay-btn open-folder-btn" aria-label="Mở thư mục: {{ item.name }}" title="Mở thư mục">
                <span class="material-symbols-outlined">open_in_new</span>
            </button>
            {% endif %}
            <button type="button" class="overlay-btn delete-btn" aria-label="Xóa: {{ item.name }}" title="Xóa">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>

        <div class="media-info">
            <h4 class="media-name" title="{{ item.name }}">{{ item.name }}</h4>
            <p class="media-meta">
                {% if item.type == 'file' %}
                    {{ item.file_type }} • {{ item.sizes|filesizeformat if item.sizes else 'N/A' }} • {{ item.updated_at|datetimeformat('%d/%m/%Y %H:%M') if item.updated_at else '' }}
                {% else %}
                    Thư mục • {{ item.updated_at|datetimeformat('%d/%m/%Y %H:%M') if item.updated_at else '' }}
                {% endif %}
            </p>
        </div>
        <input type="checkbox" class="media-select" aria-label="Chọn {{ item.name }}">
    </article>
    {% endfor %}
{% else %}
    {# Empty state will be handled by JS #}
{% endif %}

{# Load more trigger for infinite scroll #}
{% if has_more and next_cursor %}
<div class="load-more-trigger"
     data-next-cursor="{{ next_cursor }}"
     data-folder-id="{{ folder_id if folder_id is not none else 'root' }}"
     data-is-desc="{{ 'true' if is_desc else 'false' }}"
     hx-get="/api/media/items/html"
     hx-trigger="intersect once"
     hx-target="#media-grid"
     hx-swap="beforeend"
     hx-include="[name='folder_id'], [name='is_desc']"
     style="display: none;">
</div>
{% else %}
<div class="end-of-list" data-folder-id="{{ folder_id if folder_id is not none else 'root' }}">
    <span class="material-symbols-outlined">check_circle</span>
    Đã tải hết
</div>
{% endif %}