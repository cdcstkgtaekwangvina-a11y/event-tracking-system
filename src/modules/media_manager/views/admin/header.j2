<div class="media-header" x-data="{
        current_media: null,
        folder_id: new URLSearchParams(window.location.search).get('folder_id'),
        viewMode: localStorage.getItem('mediaViewMode') || 'grid',
        syncFromLocation() {
            const params = new URLSearchParams(window.location.search);
            this.folder_id = params.get('folder_id') || '';
            deleted_media = window.location.pathname === new URL(trashPageUrl, window.location.origin).pathname;
        },
        async getCurrentMedia() {
            if (this.folder_id === '' || this.folder_id === null || this.folder_id === undefined ) return;
            while (!window.fetchHelper) {
                await new Promise(resolve => setTimeout(resolve, 50));
            }
            const media = await window.fetchHelper.get('media/' + this.folder_id + `?deleted_media=${deleted_media}`);
            if(!Number.isFinite(+this.folder_id)) {
                // stop if folder_id is not a number-like value
                return;
            }
            if(media.status_code === 200){
                this.current_media = media.data;
            }
        },
        log(){
            console.log('Folder id', this.folder_id)
            console.log(this.current_media);
            return;
        },
        setViewMode(mode){
            this.viewMode = mode;
            localStorage.setItem('mediaViewMode', mode);
        },
        getCurrentFolderId(){
            return this.folder_id;
        },
        init() {
            this.syncFromLocation();
            window.addEventListener('popstate', () => this.syncFromLocation());
        }

        }" @view-mode-changed.window="setViewMode($event.detail.mode)">
    <div class="media-header-top-area">
        <div class="media-header-top">
            <div class="media-title-group">
                <h2 x-text="deleted_media ? 'Thùng rác' : 'Quản lý File'"></h2>
            </div>
            <div class="media-header-buttons">
                <button type="button" class="upload-button" x-show="!deleted_media"
                    @click="window.mediaCreateModal?.open({ mode: 'file', folderId: folder_id })">
                    <span class="material-symbols-outlined">upload</span>
                    <span x-show="!$store.screen.isMobile">Tải lên</span>
                </button>
                <button type="button" class="create-folder-button" x-show="!deleted_media"
                    @click="window.mediaCreateModal?.open({ mode: 'folder', folderId: folder_id })">
                    <span class="material-symbols-outlined">folder</span>
                    <span x-show="!$store.screen.isMobile">Tạo thư mục</span>
                </button>

                <button type="button" class="trash-button" x-show="hasData"
                    @click.prevent="deleted_media ? (hasData ? window.mediaActions?.emptyTrash() : window.mediaActions?.goManager()) : window.mediaActions?.showTrash()">
                    <span class="material-symbols-outlined">delete</span>
                    <span x-show="!$store.screen.isMobile"
                        x-text="deleted_media ? 'Làm trống thùng rác' : 'Thùng rác'"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="media-header-middle" x-init="getCurrentMedia()">
        <div class="address-bar" id="media-address-bar">
            <a href="#" @click.prevent="() => {current_media = null; folder_id = ''; window.mediaActions?.goHome(); }"
                class="address-bar-item">
                <span class="material-symbols-outlined" style="color: var(--text-secondary);">home</span>
                <span class="address-bar-item-text">Tất cả file</span>
            </a>
            <template x-for="p in (current_media && current_media.prefix) ? current_media.prefix : []" :key="p.id">
                <div class="address-bar-segment">
                    <span class="material-symbols-outlined address-bar-chevron">chevron_right</span>
                    <a href="#" @click.prevent="window.mediaActions?.goToFolder(p.id)" class="address-bar-item">
                        <span class="address-bar-item-text" x-text="p.name"></span>
                    </a>
                </div>
            </template>

            <template x-if="current_media">
                <div class="address-bar-segment">
                    <span class="material-symbols-outlined address-bar-chevron">chevron_right</span>
                    <a href="#" @click.prevent="window.mediaActions?.goToFolder(current_media.id)"
                        class="address-bar-item">
                        <span class="address-bar-item-text" x-text="current_media.name"></span>
                    </a>
                </div>
            </template>
        </div>
    </div>
    <div class="media-header-bottom" x-data="{
            filterOpen: false,
            sortOpen: false,
            trashOpen: false,
            filterValue: new URLSearchParams(window.location.search).get('type_filter') || 'all',
            sortValue: new URLSearchParams(window.location.search).get('sort_field') || 'updated_at',
            sortDir: new URLSearchParams(window.location.search).get('is_desc') === 'false' ? 'asc' : 'desc',
            init() {
                const searchParam = new URLSearchParams(window.location.search).get('search');
                if (searchParam && this.$refs.searchInput) {
                    this.$refs.searchInput.value = searchParam;
                }

                this.$watch('filterValue', value => {
                    this.reload()
                })
                this.$watch('sortValue', () => {
                    this.reload()
                })
                this.$watch('sortDir', () => {
                    this.reload()
                })
            },
            reload(extraParams = {}) {
                const container = document.getElementById('media-items-container')
                if (!container) return
                const params = new URLSearchParams(window.location.search)

                if (this.filterValue && this.filterValue !== 'all') {
                    params.set('type_filter', this.filterValue)
                } else {
                    params.delete('type_filter')
                }

                if (this.$refs.searchInput && this.$refs.searchInput.value) {
                    params.set('search', this.$refs.searchInput.value)
                } else {
                    params.delete('search')
                }

                if (this.sortValue) {
                    params.set('sort_field', this.sortValue)
                    params.set('is_desc', this.sortDir === 'desc' ? 'true' : 'false')
                }

                if (Object.prototype.hasOwnProperty.call(extraParams, 'includeDeleted')) {
                    if (extraParams.includeDeleted) {
                        params.set('deleted_media', 'true')
                    } else {
                        params.delete('deleted_media')
                    }
                }

                const isTrashPage = window.location.pathname === new URL(trashPageUrl, window.location.origin).pathname
                deleted_media = Object.prototype.hasOwnProperty.call(extraParams, 'includeDeleted')
                    ? !!extraParams.includeDeleted
                    : isTrashPage

                if (deleted_media) {
                    params.set('deleted_media', 'true')
                } else {
                    params.delete('deleted_media')
                }

                const pushParams = new URLSearchParams(params)
                pushParams.delete('deleted_media')
                const pushUrl = `${deleted_media ? trashPageUrl : managerPageUrl}${pushParams.toString() ? `?${pushParams.toString()}` : ''}`
                window.history.pushState(null, '', pushUrl)

                const query = params.toString()
                const url = `{{ url_for('media_manager') }}/items/html${query ? `?${query}` : ''}`
                container.innerHTML = `<div class='media-loading'><div class='spinner-sm'></div><span>Đang tải dữ liệu...</span></div>`
                htmx.ajax('GET', url, { target: '#media-items-container', swap: 'innerHTML' })
                syncHeaderState()
            }
        }">
        <div class="mhb-search">
            <span class="material-symbols-outlined mhb-search-icon">search</span>
            <input type="text" class="mhb-search-input" placeholder="Tìm kiếm file và thư mục..." x-ref="searchInput"
                @keyup.enter="$parent.reload()">
        </div>
        <div class="mhb-actions">
            <!-- Filter dropdown -->
            <div class="mhb-dropdown-wrapper" @click.outside="filterOpen = false">
                <button class="mhb-dropdown-btn" @click="filterOpen = !filterOpen" :class="{ 'active': filterOpen }">
                    <span class="material-symbols-outlined" style="font-size: 18px;">filter_list</span>
                    <span class="mhb-dropdown-label" x-text="
                        filterValue === 'all' ? 'Tất cả' :
                        filterValue === 'image' ? 'Hình ảnh' :
                        filterValue === 'video' ? 'Video' :
                        filterValue === 'audio' ? 'Âm thanh' :
                        filterValue === 'document' ? 'Tài liệu' :
                        filterValue === 'folder' ? 'Thư mục' :
                        filterValue === 'other' ? 'Khác' : 'Tất cả'
                    "></span>
                    <span class="material-symbols-outlined mhb-dropdown-chevron"
                        :style="filterOpen && 'transform: rotate(180deg)'">expand_more</span>
                </button>
                <div class="mhb-dropdown-menu" x-show="filterOpen" x-transition.opacity.duration.150ms>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'all' }"
                        @click="filterValue = 'all'; filterOpen = false">Tất cả</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'image' }"
                        @click="filterValue = 'image'; filterOpen = false">Hình ảnh</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'video' }"
                        @click="filterValue = 'video'; filterOpen = false">Video</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'audio' }"
                        @click="filterValue = 'audio'; filterOpen = false">Âm thanh</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'document' }"
                        @click="filterValue = 'document'; filterOpen = false">Tài liệu</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'folder' }"
                        @click="filterValue = 'folder'; filterOpen = false">Thư mục</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': filterValue === 'other' }"
                        @click="filterValue = 'other'; filterOpen = false">Khác</button>
                </div>
            </div>

            <!-- Sort dropdown -->
            <div class="mhb-dropdown-wrapper" @click.outside="sortOpen = false">
                <button class="mhb-dropdown-btn" @click="sortOpen = !sortOpen" :class="{ 'active': sortOpen }">
                    <span class="material-symbols-outlined" style="font-size: 18px;">swap_vert</span>
                    <span class="mhb-dropdown-label" x-text="
                        sortValue === 'name' ? 'Tên' :
                        sortValue === 'created_at' ? 'Ngày tạo' :
                        sortValue === 'media_metadata.sizes' ? 'Kích thước' :
                        sortValue === 'updated_at' ? 'Ngày sửa đổi' : 'Tên'
                    "></span>
                    <span x-text="sortDir === 'desc' ? '↓' : '↑'" style="font-size: 13px;"></span>
                    <span class="material-symbols-outlined mhb-dropdown-chevron"
                        :style="sortOpen && 'transform: rotate(180deg)'">expand_more</span>
                </button>
                <div class="mhb-dropdown-menu" x-show="sortOpen" x-transition.opacity.duration.150ms>
                    <button class="mhb-dropdown-item" :class="{ 'selected': sortValue === 'name' }"
                        @click="sortValue = 'name'; sortOpen = false">Tên</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': sortValue === 'created_at' }"
                        @click="sortValue = 'created_at'; sortOpen = false">Ngày tạo</button>
                    <button class="mhb-dropdown-item" :class="{ 'selected': sortValue === 'updated_at' }"
                        @click="sortValue = 'updated_at'; sortOpen = false">Ngày sửa đổi</button>
                    <div class="mhb-dropdown-divider"></div>
                    <button class="mhb-dropdown-item"
                        @click="sortDir = sortDir === 'asc' ? 'desc' : 'asc'; sortOpen = false">
                        <span class="material-symbols-outlined" style="font-size: 16px;"
                            x-text="sortDir === 'asc' ? 'arrow_upward' : 'arrow_downward'"></span>
                        <span x-text="sortDir === 'asc' ? 'Tăng dần' : 'Giảm dần'"></span>
                    </button>
                </div>
            </div>

            <!-- View toggle -->
            <div class="mhb-view-toggle">
                <button class="mhb-view-btn" :class="{ 'active': viewMode === 'grid' }"
                    @click="$dispatch('view-mode-changed', {mode: 'grid'})" title="Chế độ lưới">
                    <span class="material-symbols-outlined">grid_view</span>
                </button>
                <button class="mhb-view-btn" :class="{ 'active': viewMode === 'list' }"
                    @click="$dispatch('view-mode-changed', {mode: 'list'})" title="Chế độ danh sách">
                    <span class="material-symbols-outlined">view_list</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Action Toolbar -->
<div class="bulk-action-toolbar" x-show="$store.mediaSelection.hasSelection()" x-transition.duration.200ms x-cloak>
    <div class="bulk-action-left">
        <span class="material-symbols-outlined bulk-check-icon">check_box</span>
        <span class="bulk-count-text"
            x-text="'&#272;&#227; ch&#7885;n ' + $store.mediaSelection.getCount() + ' m&#7909;c'"></span>
        <div class="bulk-action-buttons">
            <button type="button" class="bulk-btn bulk-btn--danger" @click="window.mediaActions?.bulkDelete()">
                <span class="material-symbols-outlined" x-text="deleted_media ? 'delete_forever' : 'delete'"></span>
                <span x-text="deleted_media ? 'Xóa vĩnh viễn' : 'Chuyển vào thùng rác'"></span>
            </button>
        </div>
    </div>
    <button type="button" class="bulk-close-btn" @click="$store.mediaSelection.clear()" title="&#272;&#243;ng">
        <span class="material-symbols-outlined">close</span>
    </button>
</div>



<!-- Modal đổi tên file/thư mục (Grid View) -->
<div x-data="mediaRenameModal" @open-rename-modal.window="openModal($event.detail)" x-show="isOpen"
    class="nc-modal-overlay" style="display: none; z-index: 9999;" x-cloak>
    <div class="nc-modal" @click.stop style="max-width: 400px; width: 100%;">
        <div class="nc-modal__header"
            style="display: flex; justify-content: space-between; align-items: center; padding: 16px;">
            <h3 class="nc-modal__title" style="margin: 0; font-size: 16px;">Đổi tên</h3>
            <button class="nc-toast__close"
                style="margin: 0; width: 28px; height: 28px; font-size: 20px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: var(--text-secondary); cursor: pointer;"
                @click="closeModal()">&times;</button>
        </div>
        <div class="nc-modal__body" style="padding: 16px;">
            <div>
                <label style="display: block; font-size: 13px; margin-bottom: 6px; font-weight: 500;">Tên mới</label>
                <input type="text" x-model="newName" x-ref="renameInput" class="form-control"
                    style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); font-size: 14px; box-sizing: border-box;"
                    placeholder="Nhập tên mới..." @keydown.enter="submit()">
            </div>
        </div>
        <div class="nc-modal__footer" style="padding: 12px 16px;">
            <div class="nc-modal__actions nc-modal__actions--end"
                style="width: 100%; justify-content: flex-end; gap: 10px;">
                <button class="nc-modal__btn nc-modal__btn--secondary" @click="closeModal()">Hủy</button>
                <button class="nc-modal__btn nc-modal__btn--primary" @click="submit()"
                    x-bind:disabled="isDisable">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal chọn thư mục đích để di chuyển -->
<div x-data="folderMoveModal" @open-move-modal.window="openModal($event.detail.itemId)" x-show="isOpen"
    class="nc-modal-overlay" style="display: none; z-index: 9999;" x-cloak>
    <div class="nc-modal" @click.stop style="max-width: 450px; width: 100%;">
        <div class="nc-modal__header"
            style="display: flex; justify-content: space-between; align-items: center; padding: 16px;">
            <h3 class="nc-modal__title" style="margin: 0; font-size: 16px;">Chọn thư mục đích</h3>
            <button class="nc-toast__close"
                style="margin: 0; width: 28px; height: 28px; font-size: 20px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: var(--text-secondary); cursor: pointer;"
                @click="closeModal()">&times;</button>
        </div>
        <div class="nc-modal__body" style="padding: 10px 16px; min-height: 250px; max-height: 400px; overflow-y: auto;">
            <div x-show="loading" style="text-align: center; padding: 40px;">
                <div class="spinner-sm" style="margin: 0 auto;"></div>
            </div>

            <div x-show="!loading">
                <!-- Breadcrumb -->
                <div
                    style="margin-bottom: 15px; display: flex; gap: 5px; align-items: center; color: var(--primary); cursor: pointer; font-size: 13px; flex-wrap: wrap;">
                    <span @click="loadFolders(null)">🏠 Gốc</span>
                    <template x-for="crumb in breadcrumbs" :key="crumb.id">
                        <span style="display: flex; align-items: center; gap: 5px;">
                            <span class="material-symbols-outlined"
                                style="font-size: 14px; color: var(--text-secondary)">chevron_right</span>
                            <span @click="loadFolders(crumb)" x-text="crumb.name"></span>
                        </span>
                    </template>
                </div>

                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px;">
                    <template x-for="folder in folders" :key="folder.id">
                        <li style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: 6px; cursor: pointer; transition: background 0.2s;"
                            onmouseover="this.style.backgroundColor='var(--border)'"
                            onmouseout="this.style.backgroundColor='transparent'" @click="loadFolders(folder)">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="material-symbols-outlined media-icon--folder"
                                    style="font-size: 20px; color: #F8D775">folder</span>
                                <span x-text="folder.name" style="font-size: 14px;"></span>
                            </div>
                            <span class="material-symbols-outlined"
                                style="font-size: 16px; color: var(--text-secondary)">chevron_right</span>
                        </li>
                    </template>
                    <li x-show="folders.length === 0"
                        style="text-align: center; color: var(--text-secondary); padding: 40px 20px; font-size: 14px;">
                        Thư mục trống
                    </li>
                </ul>
            </div>
        </div>
        <div class="nc-modal__footer" style="padding: 12px 16px;">
            <div class="nc-modal__actions nc-modal__actions--end" style="width: 100%; justify-content: space-between;">
                <button class="nc-modal__btn nc-modal__btn--secondary" @click="closeModal()">Hủy</button>
                <button class="nc-modal__btn nc-modal__btn--primary" @click="confirmMove(currentParentId)"
                    x-text="currentParentId ? 'Di chuyển tới đây' : 'Di chuyển ra Gốc'"></button>
            </div>
        </div>
    </div>
</div>


<!-- Modal tạo thư mục / tải lên -->
<div x-data="mediaCreateModal" @open-create-modal.window="openModal($event.detail)" x-show="isOpen"
    class="nc-modal-overlay" style="display: none; z-index: 9999;" x-cloak>
    <div class="nc-modal" @click.stop style="max-width: 400px; width: 100%;">
        <div class="nc-modal__header"
            style="display: flex; justify-content: space-between; align-items: center; padding: 16px;">
            <h3 class="nc-modal__title" style="margin: 0; font-size: 16px;"
                x-text="mode === 'folder' ? 'Tạo thư mục mới' : 'Tải lên File'"></h3>
            <button class="nc-toast__close"
                style="margin: 0; width: 28px; height: 28px; font-size: 20px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: var(--text-secondary); cursor: pointer;"
                @click="closeModal()">&times;</button>
        </div>
        <div class="nc-modal__body" style="padding: 16px;">
            <template x-if="mode === 'folder'">
                <div>
                    <label style="display: block; font-size: 13px; margin-bottom: 6px; font-weight: 500;">Tên thư
                        mục</label>
                    <input type="text" x-model="folderName" x-ref="folderInput" class="form-control"
                        style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); font-size: 14px;"
                        placeholder="Nhập tên thư mục..." @keydown.enter="submitFolder()">
                </div>
            </template>
            <template x-if="mode === 'file'">
                <div>
                    <div style="
                            margin-top: 8px;
                            border: 2px dashed var(--border);
                            border-radius: 12px;
                            padding: 28px 16px;
                            text-align: center;
                            background: var(--bg-secondary);
                            cursor: pointer;
                            transition: border-color 0.15s ease, background-color 0.15s ease;
                        " @click="$refs.fileInput.click()" @dragover.prevent="" @drop.prevent="handleFileDrop($event)">
                        <span class="material-symbols-outlined"
                            style="font-size: 32px; color: var(--text-secondary);">cloud_upload</span>
                        <p style="margin: 10px 0 4px; font-weight: 500; font-size: 14px;">
                            Kéo thả file hoặc click để chọn
                        </p>
                        <p style="margin: 0; font-size: 12px; color: var(--text-secondary);">
                            Tối đa <span x-text="maxFileSizeLabel"></span> mỗi file
                        </p>
                        <input type="file" x-ref="fileInput" class="form-control" style="display: none;"
                            @change="onFileSelected($event)" />
                    </div>
                    <div x-show="fileName" style="margin-top: 12px;">
                        <label style="display: block; font-size: 13px; margin-bottom: 6px; font-weight: 500;">Tên
                            file</label>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <input type="text" x-model="fileName" class="form-control"
                                style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); font-size: 14px; box-sizing: border-box;">
                            <button type="button"
                                style="border: none; background: transparent; color: var(--text-secondary); cursor: pointer; font-size: 18px; line-height: 1; flex-shrink: 0;"
                                @click="clearFile()">&times;</button>
                        </div>
                    </div>
                </div>
            </template>
        </div>
        <div class="nc-modal__footer" style="padding: 12px 16px;">
            <div class="nc-modal__actions nc-modal__actions--end"
                style="width: 100%; justify-content: flex-end; gap: 10px;">
                <button class="nc-modal__btn nc-modal__btn--secondary" @click="closeModal()">Hủy</button>
                <button class="nc-modal__btn nc-modal__btn--primary" @click="submit()"
                    x-text="mode === 'folder' ? 'Tạo mới' : 'Tải lên'" x-bind:disabled="isDisable"></button>
            </div>
        </div>
    </div>
</div>


<script>
    window.managerPageUrl = "{{ url_for('media_manager') }}";
    window.trashPageUrl = "{{ url_for('trash') }}";
</script>
<link rel="stylesheet" href="/static/css/media_manager.css">
<script src="/static/js/media_manager.js"></script>
