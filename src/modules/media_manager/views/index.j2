{% extends "templates/index.j2" %}
{% block title %}Quản lý Media{% endblock %}
{% block content %}
<div class="media-manager">
    <!-- Toolbar -->
    <div class="media-toolbar">
        <div class="toolbar-left">
            <h1 class="page-title">
                <span class="material-symbols-outlined">photo_library</span>
                Thư viện Media
            </h1>
            <nav class="media-tabs" role="tablist">
                <button role="tab" class="tab-btn active" data-tab="all" aria-selected="true">
                    Tất cả <span class="tab-count" id="count-all">0</span>
                </button>
                <button role="tab" class="tab-btn" data-tab="images" aria-selected="false">
                    Hình ảnh <span class="tab-count" id="count-images">0</span>
                </button>
                <button role="tab" class="tab-btn" data-tab="videos" aria-selected="false">
                    Video <span class="tab-count" id="count-videos">0</span>
                </button>
                <button role="tab" class="tab-btn" data-tab="documents" aria-selected="false">
                    Tài liệu <span class="tab-count" id="count-documents">0</span>
                </button>
                <button role="tab" class="tab-btn" data-tab="audio" aria-selected="false">
                    Audio <span class="tab-count" id="count-audio">0</span>
                </button>
            </nav>
        </div>
        <div class="toolbar-right">
            <div class="view-toggle" role="group" aria-label="Chế độ xem">
                <button type="button" class="view-btn active" data-view="grid" aria-label="Xem lưới" title="Xem lưới">
                    <span class="material-symbols-outlined">grid_view</span>
                </button>
                <button type="button" class="view-btn" data-view="list" aria-label="Xem danh sách" title="Xem danh sách">
                    <span class="material-symbols-outlined">view_list</span>
                </button>
            </div>
            <div class="sort-select">
                <label for="sort-select" class="sr-only">Sắp xếp</label>
                <select id="sort-select" class="form-select">
                    <option value="-updated_at">Mới nhất</option>
                    <option value="updated_at">Cũ nhất</option>
                    <option value="name">Tên (A-Z)</option>
                    <option value="-name">Tên (Z-A)</option>
                    <option value="-size">Kích thước (Lớn → Nhỏ)</option>
                    <option value="size">Kích thước (Nhỏ → Lớn)</option>
                </select>
            </div>
            <button type="button" class="btn btn-primary" id="btn-add-media" aria-label="Thêm media">
                <span class="material-symbols-outlined">add</span>
                Thêm mới
            </button>
        </div>
    </div>

    <!-- Breadcrumb / Folder navigation -->
    <div class="media-breadcrumb" id="media-breadcrumb">
        <button class="breadcrumb-item active" data-folder-id="root" aria-current="page">
            <span class="material-symbols-outlined">folder</span>
            Tất cả file
        </button>
    </div>

    <!-- Main content area -->
    <div class="media-content">
        <!-- Sidebar: Folder tree -->
        <aside class="media-sidebar" id="media-sidebar" role="complementary" aria-label="Cấu trúc thư mục">
            <div class="sidebar-header">
                <h3>Thư mục</h3>
                <button type="button" class="btn btn-sm btn-outline" id="btn-new-folder-sidebar" aria-label="Tạo thư mục mới">
                    <span class="material-symbols-outlined">create_new_folder</span>
                </button>
            </div>
            <div class="folder-tree" id="folder-tree" role="tree" aria-label="Danh sách thư mục">
                <div class="folder-node root-node" data-folder-id="root" role="treeitem" aria-expanded="true" aria-level="1">
                    <button class="folder-toggle" aria-label="Mở/đóng thư mục gốc">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                    <span class="folder-icon">
                        <span class="material-symbols-outlined">folder</span>
                    </span>
                    <span class="folder-name">Tất cả file</span>
                    <span class="folder-count" id="folder-count-root">0</span>
                </div>
                <ul class="folder-children" role="group" aria-label="Thư mục con">
                    <!-- Folder children loaded via JS -->
                </ul>
            </div>
        </aside>

        <!-- Main grid/list area -->
        <main class="media-main" role="main">
            <!-- Drop zone for upload -->
            <div class="drop-zone" id="drop-zone" aria-live="polite">
                <div class="drop-zone-content">
                    <span class="material-symbols-outlined drop-icon">cloud_upload</span>
                    <p>Kéo thả file vào đây hoặc</p>
                    <button type="button" class="btn btn-primary" id="btn-select-files">Chọn file</button>
                    <input type="file" id="file-input" multiple hidden>
                    <p class="drop-hint">Hỗ trợ: hình ảnh, video, tài liệu, audio</p>
                </div>
            </div>

            <!-- Items container (grid or list) -->
            <div class="media-items-container" id="media-items-container">
                <div class="media-grid" id="media-grid" role="list" aria-label="Danh sách media">
                    <!-- Items loaded via HTMX -->
                    <div class="loading-placeholder">
                        <div class="spinner"></div>
                        <p>Đang tải...</p>
                    </div>
                </div>
                <div class="media-list" id="media-list" role="list" aria-label="Danh sách media (chế độ danh sách)" hidden>
                    <!-- List view loaded via HTMX -->
                </div>
            </div>

            <!-- Load more / Infinite scroll trigger -->
            <div class="load-more-container" id="load-more-container">
                <button type="button" class="btn btn-outline load-more-btn" id="load-more-btn" hidden>
                    <span class="material-symbols-outlined">keyboard_arrow_down</span>
                    Tải thêm
                </button>
                <div class="end-message" id="end-message" hidden>
                    <span class="material-symbols-outlined">check_circle</span>
                    Đã tải hết
                </div>
            </div>

            <!-- Empty state -->
            <div class="empty-state" id="empty-state" hidden>
                <span class="material-symbols-outlined empty-icon">photo_library</span>
                <h3>Chưa có file nào</h3>
                <p>Kéo thả hoặc nhấn "Thêm mới" để tải file lên</p>
                <button type="button" class="btn btn-primary" id="btn-upload-empty">Tải file lên</button>
            </div>
        </main>
    </div>

    <!-- Upload Progress Modal -->
    <dialog class="modal" id="upload-modal" aria-modal="true" aria-labelledby="upload-modal-title">
        <div class="modal-backdrop"></div>
        <div class="modal-content upload-modal-content">
            <header class="modal-header">
                <h2 id="upload-modal-title">Đang tải lên</h2>
                <button type="button" class="modal-close" aria-label="Đóng">&times;</button>
            </header>
            <div class="modal-body">
                <div class="upload-progress-list" id="upload-progress-list">
                    <!-- Upload items added dynamically -->
                </div>
                <div class="upload-summary" id="upload-summary" hidden>
                    <p><strong id="upload-success-count">0</strong> thành công, <strong id="upload-fail-count">0</strong> thất bại</p>
                </div>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-close-upload-modal" hidden>Đóng</button>
            </footer>
        </div>
    </dialog>

    <!-- Create Folder Modal -->
    <dialog class="modal" id="folder-modal" aria-modal="true" aria-labelledby="folder-modal-title">
        <div class="modal-backdrop"></div>
        <div class="modal-content">
            <header class="modal-header">
                <h2 id="folder-modal-title">Tạo thư mục mới</h2>
                <button type="button" class="modal-close" aria-label="Đóng">&times;</button>
            </header>
            <form id="folder-form" class="modal-body">
                <input type="hidden" name="parent_id" id="folder-parent-id">
                <div class="form-group">
                    <label for="folder-name">Tên thư mục</label>
                    <input type="text" id="folder-name" name="name" required maxlength="300" placeholder="Nhập tên thư mục">
                    <span class="form-error" id="folder-name-error" hidden></span>
                </div>
            </form>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-cancel-folder">Hủy</button>
                <button type="button" class="btn btn-primary" id="btn-submit-folder">Tạo</button>
            </footer>
        </div>
    </dialog>

    <!-- Rename Modal -->
    <dialog class="modal" id="rename-modal" aria-modal="true" aria-labelledby="rename-modal-title">
        <div class="modal-backdrop"></div>
        <div class="modal-content">
            <header class="modal-header">
                <h2 id="rename-modal-title">Đổi tên</h2>
                <button type="button" class="modal-close" aria-label="Đóng">&times;</button>
            </header>
            <form id="rename-form" class="modal-body">
                <input type="hidden" name="item_id" id="rename-item-id">
                <input type="hidden" name="item_type" id="rename-item-type">
                <div class="form-group">
                    <label for="rename-name">Tên mới</label>
                    <input type="text" id="rename-name" name="name" required maxlength="300">
                    <span class="form-error" id="rename-name-error" hidden></span>
                </div>
            </form>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-cancel-rename">Hủy</button>
                <button type="button" class="btn btn-primary" id="btn-submit-rename">Lưu</button>
            </footer>
        </div>
    </dialog>

    <!-- Delete Confirm Modal -->
    <dialog class="modal" id="delete-modal" aria-modal="true" aria-labelledby="delete-modal-title">
        <div class="modal-backdrop"></div>
        <div class="modal-content modal-confirm">
            <header class="modal-header">
                <h2 id="delete-modal-title">Xác nhận xóa</h2>
                <button type="button" class="modal-close" aria-label="Đóng">&times;</button>
            </header>
            <div class="modal-body">
                <p id="delete-message">Bạn có chắc chắn muốn xóa mục này?</p>
                <p class="delete-warning" id="delete-warning" hidden>Thao tác này không thể hoàn tác.</p>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-cancel-delete">Hủy</button>
                <button type="button" class="btn btn-danger" id="btn-confirm-delete">Xóa</button>
            </footer>
        </div>
    </dialog>

    <!-- Detail/Preview Modal -->
    <dialog class="modal modal-lg" id="detail-modal" aria-modal="true" aria-labelledby="detail-modal-title">
        <div class="modal-backdrop"></div>
        <div class="modal-content detail-modal-content">
            <header class="modal-header">
                <h2 id="detail-modal-title">Chi tiết</h2>
                <button type="button" class="modal-close" aria-label="Đóng">&times;</button>
            </header>
            <div class="modal-body">
                <div class="detail-preview" id="detail-preview">
                    <!-- Preview content loaded dynamically -->
                </div>
                <div class="detail-info" id="detail-info">
                    <!-- Metadata displayed here -->
                </div>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-close-detail">Đóng</button>
                <button type="button" class="btn btn-primary" id="btn-copy-url" hidden>Copy URL</button>
                <button type="button" class="btn btn-danger" id="btn-delete-from-detail" hidden>Xóa</button>
            </footer>
        </div>
    </dialog>
</div>

<!-- Template for media grid item -->
<template id="media-grid-item-template">
    <article class="media-item media-grid-item" data-id="" data-type="" data-url="">
        <div class="media-thumbnail">
            <!-- Thumbnail/image/video placeholder -->
        </div>
        <div class="media-overlay">
            <button type="button" class="overlay-btn preview-btn" aria-label="Xem trước" title="Xem trước">
                <span class="material-symbols-outlined">visibility</span>
            </button>
            <button type="button" class="overlay-btn download-btn" aria-label="Tải xuống" title="Tải xuống">
                <span class="material-symbols-outlined">download</span>
            </button>
            <button type="button" class="overlay-btn rename-btn" aria-label="Đổi tên" title="Đổi tên">
                <span class="material-symbols-outlined">edit</span>
            </button>
            <button type="button" class="overlay-btn delete-btn" aria-label="Xóa" title="Xóa">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>
        <div class="media-info">
            <h4 class="media-name"></h4>
            <p class="media-meta"></p>
        </div>
        <input type="checkbox" class="media-select" aria-label="Chọn">
    </article>
</template>

<!-- Template for media list item -->
<template id="media-list-item-template">
    <div class="media-item media-list-item" data-id="" data-type="" data-url="">
        <div class="list-thumbnail"></div>
        <div class="list-info">
            <h4 class="media-name"></h4>
            <p class="media-meta"></p>
        </div>
        <div class="list-actions">
            <button type="button" class="action-btn preview-btn" aria-label="Xem trước" title="Xem trước">
                <span class="material-symbols-outlined">visibility</span>
            </button>
            <button type="button" class="action-btn download-btn" aria-label="Tải xuống" title="Tải xuống">
                <span class="material-symbols-outlined">download</span>
            </button>
            <button type="button" class="action-btn rename-btn" aria-label="Đổi tên" title="Đổi tên">
                <span class="material-symbols-outlined">edit</span>
            </button>
            <button type="button" class="action-btn delete-btn" aria-label="Xóa" title="Xóa">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>
        <input type="checkbox" class="media-select" aria-label="Chọn">
    </div>
</template>

<script type="module" src="/static/js/media-manager.js"></script>
{% endblock %}