<!-- Account Create / Edit Modal -->
<div class="acc-modal-backdrop" id="acc-form-modal-backdrop"
     x-show="isOpen"
     style="display: none;"
     x-cloak
     @click.self="close"
     x-data="accountFormModal({{ can_edit_email | tojson }})">
    <div class="acc-modal" @click.stop>
        <div class="acc-modal-header">
            <h3 class="acc-modal-title" x-text="mode === 'edit' ? 'Chỉnh sửa tài khoản' : 'Thêm tài khoản'">
                Thêm tài khoản
            </h3>
            <button class="acc-modal-close" @click="close" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form class="acc-modal-body" @submit.prevent="submit">
            <div class="acc-form-row">
                <div class="acc-form-group acc-form-group--full">
                    <label class="acc-form-label">Họ và tên <span class="acc-required">*</span></label>
                    <input type="text" class="acc-form-input" x-model="form.name" placeholder="Nguyễn Văn A"
                        maxlength="300" autocomplete="off" required />
                </div>
            </div>

            <div class="acc-form-row">
                <div class="acc-form-group">
                    <label class="acc-form-label">Tên đăng nhập <span class="acc-required">*</span></label>
                    <input type="text" class="acc-form-input" x-model="form.username" placeholder="username"
                        maxlength="350" autocomplete="off" required />
                </div>
                <div class="acc-form-group">
                    <label class="acc-form-label">
                        Email <span class="acc-required" x-show="mode === 'create'">*</span>
                        <span class="material-symbols-outlined acc-tooltip-icon" x-show="mode === 'edit' && !canEditEmail"
                            title="Chỉ Super Admin mới có quyền chỉnh sửa Email">info</span>
                    </label>
                    <input type="email" class="acc-form-input" x-model="form.email" placeholder="name@company.com"
                        maxlength="300" autocomplete="off"
                        :disabled="mode === 'edit' && !canEditEmail"
                        :required="mode === 'create'" />
                </div>
            </div>

            <div class="acc-form-row">
                <div class="acc-form-group acc-form-group--full">
                    <label class="acc-form-label">
                        Mật khẩu <span class="acc-required" x-show="mode === 'create'">*</span>
                        <span x-show="mode === 'edit'" style="font-weight: 400;">(để trống nếu không đổi)</span>
                    </label>
                    <input type="password" class="acc-form-input" x-model="form.password"
                        placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" :required="mode === 'create'" />
                </div>
            </div>

            <p class="acc-form-hint" x-show="mode === 'create'">
                Vai trò hệ thống của tài khoản mới sẽ mặc định là <strong>Admin</strong>.
            </p>

            <div class="acc-modal-footer">
                <button type="button" class="acc-btn acc-btn-ghost" @click="close">Huỷ</button>
                <button type="submit" class="acc-btn acc-btn-primary" :disabled="loading">
                    <span x-show="loading" class="acc-spinner acc-spinner-sm"></span>
                    <span x-text="loading ? 'Đang lưu...' : (mode === 'edit' ? 'Cập nhật' : 'Tạo tài khoản')">Tạo tài khoản</span>
                </button>
            </div>
        </form>
    </div>
</div>
