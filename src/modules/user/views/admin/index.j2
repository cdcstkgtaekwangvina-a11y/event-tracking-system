{% extends "templates/layouts/admin.j2" if not request.headers.get("hx-request") else
"templates/layouts/admin_blank.j2"%}
{% block admin_title %}Quản lý Tài khoản{% endblock %}
{% block admin_body %}
<div class="acc-container">
    <!-- Header -->
    <div class="acc-header">
        <h1 class="acc-title">Quản lý Tài khoản</h1>
        <div class="acc-header-actions">
            <button type="button" class="acc-btn acc-btn-primary" id="btn-add-account"
                onclick="window.accountFormModal?.open({ mode: 'create' })">
                <span class="material-symbols-outlined">add</span>
                Thêm tài khoản
            </button>
        </div>
    </div>

    <!-- Search -->
    <div class="acc-search-wrapper">
        <span class="material-symbols-outlined acc-search-icon">search</span>
        <input type="text" class="acc-search-input" id="acc-search-input"
            placeholder="Tìm theo tên, tên đăng nhập hoặc email... (Nhấn Enter để tìm)" autocomplete="off"
            hx-get="{{ url_for('accounts_table') }}" hx-trigger="keyup[key=='Enter']" hx-target="#acc-table-container"
            hx-swap="innerHTML" name="search" hx-include="#acc-search-input" />
    </div>

    <!-- Table Container -->
    <div class="acc-table-wrapper">
        <div id="acc-table-container"
             hx-get="{{ url_for('accounts_table') }}"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="acc-empty">
                <div class="acc-spinner acc-spinner-sm"></div>
                <p class="acc-empty-text">Đang tải danh sách tài khoản...</p>
            </div>
        </div>
    </div>
</div>

{% include "modules/user/views/admin/modals/account_form_modal.j2" %}

<link rel="stylesheet" href="/static/css/account.css">
<script>
    window.ACCOUNT_URLS = {
        accountsTable: "{{ url_for('accounts_table') }}"
    };
</script>
<script src="/static/js/account.js"></script>
{% endblock %}
