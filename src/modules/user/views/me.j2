{% extends "templates/index.j2"%}

{% block title %}{{ user.username if user.username else user.email }} - Hồ sơ cá nhân{% endblock %}

{% block head_extra %}
<link rel="stylesheet" href="/static/css/profile.css?v=20260830-1">
<link rel="stylesheet" href="/static/css/media_picker.css">
{% endblock %}

{% block body %}
<div class="prof-container" x-data='profilePage({{ {
        "name": user.name or "",
        "username": user.username or "",
        "email": user.email or "",
        "role": user.role or "",
        "avatar_url": user.file_url or user.avatar_url or "",
        "created_at": (user.created_at | string) if user.created_at else "",
        "is_super_admin": is_super_admin,
    } | tojson | forceescape }})' @avatar-media-selected.window="avatarUrl = $event.detail.url">

    <!-- Topbar / Title -->
    <div class="prof-header-section">
        <div class="prof-header-top">
            <button type="button" @click="goBack()" class="prof-back-btn" title="Quay lại">
                <span class="material-symbols-outlined">arrow_back</span>
                <span>Quay lại</span>
            </button>
        </div>
        <h1 class="prof-page-title">Hồ sơ cá nhân</h1>
        <p class="prof-page-subtitle">Thông tin tài khoản của bạn</p>
    </div>

    <!-- 1. Profile Summary Card -->
    <div class="prof-card prof-summary-card">
        <div class="prof-summary-left">
            <div class="prof-avatar-box" @click="openEditModal()" title="Nhấn để đổi ảnh đại diện">
                <template x-if="avatarUrl">
                    <img :src="avatarUrl" class="prof-avatar-image" alt="avatar" />
                </template>
                <template x-if="!avatarUrl">
                    <span class="prof-avatar-initials" x-text="getInitials(profileData.name)">VA</span>
                </template>
                <div class="prof-avatar-hover-icon">
                    <span class="material-symbols-outlined">photo_camera</span>
                </div>
            </div>

            <div class="prof-summary-info">
                <h2 class="prof-user-name" x-text="profileData.name || 'Người dùng'">Nguyễn Văn Admin</h2>
                <div class="prof-username-text">@<span x-text="profileData.username">admin</span></div>
                <div class="prof-summary-email" x-text="profileData.email || ''">admin@example.com</div>
                <div class="prof-meta-row">
                    <span class="prof-role-pill">
                        <span class="material-symbols-outlined">verified_user</span>
                        <span x-text="roleLabel(role)">Admin</span>
                    </span>
                    <span class="prof-joined-text" x-text="formatJoinedDate(createdAt)">Tham gia từ 10 tháng 1,
                        2024</span>
                </div>
            </div>
        </div>
        <button type="button" class="prof-edit-btn" @click="openEditModal()" title="Chỉnh sửa thông tin">
            <span class="material-symbols-outlined">edit</span>
        </button>
    </div>

    <!-- 2. Account Information Card -->
    <div class="prof-card">
        <h3 class="prof-section-title">THÔNG TIN TÀI KHOẢN</h3>
        <div class="prof-info-grid">
            <!-- Họ và tên -->
            <div class="prof-info-box">
                <div class="prof-info-icon-box">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="prof-info-content">
                    <span class="prof-info-label">Họ và tên</span>
                    <span class="prof-info-val" x-text="profileData.name || '—'">Nguyễn Văn Admin</span>
                </div>
            </div>

            <!-- Tên đăng nhập -->
            <div class="prof-info-box">
                <div class="prof-info-icon-box">
                    <span class="material-symbols-outlined">alternate_email</span>
                </div>
                <div class="prof-info-content">
                    <span class="prof-info-label">Tên đăng nhập</span>
                    <span class="prof-info-val" x-text="profileData.username || '—'">admin</span>
                </div>
            </div>

            <!-- Email -->
            <div class="prof-info-box">
                <div class="prof-info-icon-box">
                    <span class="material-symbols-outlined">mail</span>
                </div>
                <div class="prof-info-content">
                    <span class="prof-info-label">Email</span>
                    <span class="prof-info-val" x-text="profileData.email || '—'">admin@company.com</span>
                </div>
            </div>

            <!-- Vai trò -->
            <div class="prof-info-box">
                <div class="prof-info-icon-box">
                    <span class="material-symbols-outlined">verified_user</span>
                </div>
                <div class="prof-info-content">
                    <span class="prof-info-label">Vai trò</span>
                    <span class="prof-info-val" x-text="roleLabel(role)">Admin</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Security Card -->
    <div class="prof-card">
        <h3 class="prof-section-title">BẢO MẬT</h3>
        <div class="prof-security-box">
            <div class="prof-security-left">
                <div class="prof-info-icon-box">
                    <span class="material-symbols-outlined">key</span>
                </div>
                <div class="prof-security-content">
                    <span class="prof-security-title">Mật khẩu</span>
                    <span class="prof-security-desc">Cập nhật mật khẩu đăng nhập của bạn</span>
                </div>
            </div>
            <button type="button" class="prof-btn-change-pwd" @click="openPasswordModal()">
                <span class="material-symbols-outlined">key</span>
                <span>Đổi mật khẩu</span>
            </button>
        </div>
    </div>

    <!-- ============================================================
         MODAL: CHỈNH SỬA THÔNG TIN CÁ NHÂN
         ============================================================ -->
    <div class="prof-modal-backdrop" x-show="editModalOpen" x-cloak style="display: none;"
        @keydown.escape.window="closeEditModal()">
        <div class="prof-modal" @click.outside="closeEditModal()">
            <div class="prof-modal-header">
                <h3 class="prof-modal-title">Chỉnh sửa thông tin cá nhân</h3>
                <button type="button" class="prof-modal-close" @click="closeEditModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form class="prof-modal-body" @submit.prevent="saveProfile">
                <!-- Avatar Change Row in Modal -->
                <div class="prof-modal-avatar-row">
                    <div class="prof-avatar-box prof-avatar-box--modal">
                        <template x-if="avatarPreviewUrl || avatarUrl">
                            <img :src="avatarPreviewUrl || avatarUrl" class="prof-avatar-image" alt="avatar" />
                        </template>
                        <template x-if="!(avatarPreviewUrl || avatarUrl)">
                            <span class="prof-avatar-initials" x-text="getInitials(form.name)">VA</span>
                        </template>
                        <div class="prof-avatar-hover-icon">
                            <span class="material-symbols-outlined">photo_camera</span>
                        </div>
                    </div>
                    <div class="prof-modal-avatar-info">
                        <input type="file" x-ref="avatarFileInput" accept="image/*" class="prof-file-input"
                            style="display:none" @change="selectAvatarFile">
                        <button type="button" class="prof-btn prof-btn-secondary"
                            @click="$refs.avatarFileInput?.click()">
                            <span class="material-symbols-outlined">upload</span>
                            Tải ảnh lên
                        </button>
                        <span class="prof-form-hint">Chọn ảnh từ máy tính để cập nhật ảnh đại diện</span>
                        <template x-if="pendingAvatarName">
                            <span class="prof-form-hint" x-text="'Đã chọn: ' + pendingAvatarName"></span>
                        </template>
                        <template x-if="avatarUploadError">
                            <span class="prof-form-hint prof-form-hint--error" x-text="avatarUploadError"></span>
                        </template>
                    </div>
                </div>

                <div class="prof-form-group">
                    <label class="prof-form-label">Họ và tên <span class="prof-required">*</span></label>
                    <input type="text" class="prof-form-input" x-model="form.name" maxlength="300" autocomplete="off"
                        required />
                </div>

                <div class="prof-form-group">
                    <label class="prof-form-label">Tên đăng nhập <span class="prof-required">*</span></label>
                    <input type="text" class="prof-form-input" x-model="form.username" maxlength="20" autocomplete="off"
                        required />
                    <span class="prof-form-hint">3-20 ký tự, bắt đầu bằng chữ cái, chỉ chứa chữ, số, _, @</span>
                </div>

                <div class="prof-form-group">
                    <label class="prof-form-label">
                        Email
                        <span class="material-symbols-outlined prof-tooltip-icon" x-show="!isSuperAdmin"
                            title="Chỉ Super Admin mới có quyền chỉnh sửa Email">info</span>
                    </label>
                    <input type="email" class="prof-form-input" x-model="form.email" maxlength="300" autocomplete="off"
                        :disabled="!isSuperAdmin" />
                </div>

                <div class="prof-modal-footer">
                    <button type="button" class="prof-btn prof-btn-ghost" @click="closeEditModal()">Huỷ</button>
                    <button type="submit" class="prof-btn prof-btn-primary" :disabled="savingProfile">
                        <span x-show="savingProfile" class="prof-spinner prof-spinner-sm"></span>
                        <span x-text="savingProfile ? 'Đang lưu...' : 'Lưu thay đổi'">Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================================
         MODAL: ĐỔI MẬT KHẨU
         ============================================================ -->
    <div class="prof-modal-backdrop" x-show="passwordModalOpen" x-cloak style="display: none;"
        @keydown.escape.window="closePasswordModal()">
        <div class="prof-modal" @click.outside="closePasswordModal()">
            <div class="prof-modal-header">
                <h3 class="prof-modal-title">Đổi mật khẩu</h3>
                <button type="button" class="prof-modal-close" @click="closePasswordModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form class="prof-modal-body" @submit.prevent="changePassword">
                <div class="prof-form-group">
                    <label class="prof-form-label">Mật khẩu hiện tại <span class="prof-required">*</span></label>
                    <div class="prof-input-wrap">
                        <input type="password" class="prof-form-input" x-model="passwordForm.current_password"
                            autocomplete="current-password" required :type="isHideCurrent ? 'password' : 'text'" />
                        <button type="button" class="prof-toggle-pwd" @click="toggleHideCurrent"
                            :title="isHideCurrent ? 'Hiển thị mật khẩu' : 'Ẩn mật khẩu'">
                            <span class="material-symbols-outlined"
                                x-text="isHideCurrent ? 'visibility_off' : 'visibility'"></span>
                        </button>
                    </div>
                </div>

                <div class="prof-form-group">
                    <label class="prof-form-label">Mật khẩu mới <span class="prof-required">*</span></label>
                    <div class="prof-input-wrap">
                        <input type="password" class="prof-form-input" x-model="passwordForm.new_password"
                            placeholder="Tối thiểu 8 ký tự, gồm chữ hoa, thường, số và ký tự đặc biệt"
                            autocomplete="new-password" required :type="isHideNew ? 'password' : 'text'" />
                        <button type="button" class="prof-toggle-pwd" @click="toggleHideNew"
                            :title="isHideNew ? 'Hiển thị mật khẩu' : 'Ẩn mật khẩu'">
                            <span class="material-symbols-outlined"
                                x-text="isHideNew ? 'visibility_off' : 'visibility'"></span>
                        </button>
                    </div>
                </div>

                <div class="prof-form-group">
                    <label class="prof-form-label">Xác nhận mật khẩu mới <span class="prof-required">*</span></label>
                    <div class="prof-input-wrap">
                        <input type="password" class="prof-form-input" x-model="passwordForm.confirm_new_password"
                            placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required
                            :type="isHideConfirm ? 'password' : 'text'" />
                        <button type="button" class="prof-toggle-pwd" @click="toggleHideConfirm"
                            :title="isHideConfirm ? 'Hiển thị mật khẩu' : 'Ẩn mật khẩu'">
                            <span class="material-symbols-outlined"
                                x-text="isHideConfirm ? 'visibility_off' : 'visibility'"></span>
                        </button>
                    </div>
                </div>

                <p class="prof-form-hint">Mật khẩu cần ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt
                    (@$!%*?&).</p>

                <!-- Popover lỗi validation -->
                <div class="pwd-popover" x-show="passwordError" x-cloak x-transition
                    :class="{ 'pwd-popover--visible': passwordError }">
                    <span class="material-symbols-outlined pwd-popover-icon">error</span>
                    <span class="pwd-popover-text" x-text="passwordError"></span>
                    <button type="button" class="pwd-popover-close" @click="passwordError = null" title="Đóng">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="prof-modal-footer">
                    <button type="button" class="prof-btn prof-btn-ghost" @click="closePasswordModal()">Huỷ</button>
                    <button type="submit" class="prof-btn prof-btn-primary" :disabled="changingPassword">
                        <span x-show="changingPassword" class="prof-spinner prof-spinner-sm"></span>
                        <span x-text="changingPassword ? 'Đang xử lý...' : 'Đổi mật khẩu'">Đổi mật khẩu</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<!-- Chọn ảnh đại diện có sẵn từ thư viện Media -->
<div class="media-picker-modal" x-data="avatarLibraryPicker()" x-show="isOpen" x-cloak
    @keydown.escape.window="isOpen && close()">
    <div class="media-picker-backdrop" @click="close()"></div>
    <div class="media-picker-dialog media-picker-dialog--sm" @click.stop>
        <div class="media-picker-header">
            <div>
                <h3>Chọn ảnh đại diện</h3>
                <p x-text="folderId ? 'Đang xem thư mục con' : 'Chọn một ảnh có sẵn trong thư viện'"></p>
            </div>
            <div class="media-picker-header-actions">
                <button type="button" class="media-picker-nav-btn" @click="goBack()"
                    :disabled="loading || !folderStack.length">Quay lại</button>
                <button type="button" class="media-picker-nav-btn" @click="goRoot()" :disabled="loading">Trang
                    đầu</button>
                <button type="button" class="media-picker-close-btn" @click="close()">×</button>
            </div>
        </div>
        <div class="media-picker-toolbar">
            <div class="media-picker-search">
                <span class="material-symbols-outlined">search</span>
                <input type="text" placeholder="Tìm ảnh..." x-model="search" @keydown.enter.prevent="load(folderId)">
            </div>
        </div>
        <div class="media-picker-body">
            <div class="media-picker-main">
                <div class="media-picker-status" x-show="loading">
                    <div class="spinner-sm"></div>
                    <span>Đang tải...</span>
                </div>
                <div class="media-body media-picker-items" id="avatar-picker-items"></div>
            </div>
            <aside class="media-picker-sidebar">
                <template x-if="selected">
                    <div class="media-picker-detail">
                        <div class="media-picker-preview">
                            <img :src="selected.url" :alt="selected.name">
                        </div>
                        <div class="media-picker-fields">
                            <div class="media-picker-field">
                                <span class="label">Tên</span>
                                <span class="value" x-text="selected.name"></span>
                            </div>
                        </div>
                        <div class="media-picker-actions">
                            <button type="button" class="media-picker-primary" :disabled="saving" @click="confirm()">
                                <span x-text="saving ? 'Đang lưu...' : 'Dùng ảnh này'"></span>
                            </button>
                        </div>
                    </div>
                </template>
                <template x-if="!selected">
                    <div class="media-picker-empty">
                        <span class="material-symbols-outlined">photo_library</span>
                        <p>Chọn một ảnh để xem trước ở đây.</p>
                    </div>
                </template>
            </aside>
        </div>
    </div>
</div>

<script>
    window.PROFILE_URLS = {
        mediaManager: "{{ url_for('media_manager') }}"
    };
</script>
<script src="/static/js/profile.js?v=20260830-2"></script>
{% endblock %}