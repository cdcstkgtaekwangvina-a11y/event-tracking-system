<!--
  Email template: verify_auth (reset password / OTP)
  Cùng hệ phụ màu & cấu trúc với body_invite_event_aws.j2 để thống nhất brand.
-->
{% set gradients = [
    ['#3b82f6', '#8b5cf6'],
    ['#6366f1', '#06b6d4'],
    ['#8b5cf6', '#ec4899'],
    ['#10b981', '#0d9488'],
    ['#f97316', '#ef4444'],
    ['#ec4899', '#8b5cf6'],
    ['#0ea5e9', '#6366f1'],
    ['#14b8a6', '#3b82f6'],
    ['#f43f5e', '#f97316'],
    ['#a855f7', '#3b82f6'],
] %}
{% set g = gradients | random %}

<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%"
    style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06); border: 1px solid #e2e8f0; border-collapse: separate;">

    <!-- HEADER BANNER -->
    <tr>
        <td style="background: {{ g[0] }}; background: linear-gradient(135deg, {{ g[0] }} 0%, {{ g[1] }} 100%); padding: 36px 24px 32px; text-align: center; color: #ffffff;">
            <div style="display: inline-block; background-color: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-bottom: 16px; letter-spacing: 0.3px;">
                🔐 Event Tracking System
            </div>
            {% if password is defined %}
            <span style="display: inline-block; background-color: rgba(255, 255, 255, 0.25); padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 12px;">
                Đặt lại mật khẩu
            </span>
            {% elif otp is defined %}
            <span style="display: inline-block; background-color: rgba(255, 255, 255, 0.25); padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 12px;">
                Xác nhận OTP
            </span>
            {% endif %}
            <h1 style="margin: 0 0 16px; font-size: 26px; font-weight: 800; line-height: 1.3; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                {% if password is defined %}Đặt lại mật khẩu{% elif otp is defined %}Xác nhận xác thực{% endif %}
            </h1>
        </td>
    </tr>

    <!-- MAIN BODY -->
    <tr>
        <td style="padding: 32px 28px 24px; color: #1e293b;">
            <h2 style="margin: 0 0 10px; font-size: 20px; font-weight: 700; color: #0f172a;">
                Xin chào, {{ name | default(username) | default('Quý khách') }} 👋
            </h2>
            {% if password is defined %}
            <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.6; color: #475569;">
                Đội ngũ chúng tôi vừa giúp bạn đặt lại mật khẩu. Vui lòng sử dụng mật khẩu mới bên dưới để đăng nhập.
            </p>

            <!-- PASSWORD CARD -->
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px;">
                <tr>
                    <td colspan="2" style="padding-bottom: 10px; font-size: 12px; font-weight: 700; color: #b91c1c; text-transform: uppercase; letter-spacing: 0.5px;">
                        MẬT KHẨU MỚI
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center" style="padding: 8px 0;">
                        <span style="display: inline-block; background-color: #ffffff; border: 1px solid #fca5a5; border-radius: 10px; padding: 14px 20px; font-size: 22px; font-weight: 800; letter-spacing: 2px; color: #1e293b; font-family: 'SF Mono', 'Fira Code', Menlo, Consolas, monospace; box-shadow: 0 2px 8px rgba(0,0,0,0.04); min-width: 180px; text-align: center;">
                            {{ password }}
                        </span>
                    </td>
                </tr>
            </table>

            <p style="font-size: 14px; line-height: 1.6; color: #475569; margin: 0;">
                Vui lòng đổi mật khẩu ngay khi đăng nhập để đảm bảo an toàn tài khoản.
            </p>
            {% elif otp is defined %}
            <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.6; color: #475569;">
                Bạn đang thực hiện xác thực OTP. Vui lòng nhập mã bên dưới để hoàn tất.
            </p>

            <!-- OTP CARD -->
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px;">
                <tr>
                    <td colspan="2" style="padding-bottom: 10px; font-size: 12px; font-weight: 700; color: #1d4ed8; text-transform: uppercase; letter-spacing: 0.5px;">
                        MÃ OTP
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center" style="padding: 8px 0;">
                        <span style="display: inline-block; background-color: #ffffff; border: 1px solid #93c5fd; border-radius: 10px; padding: 14px 20px; font-size: 26px; font-weight: 800; letter-spacing: 6px; color: #0f172a; font-family: 'SF Mono', 'Fira Code', Menlo, Consolas, monospace; box-shadow: 0 2px 8px rgba(0,0,0,0.04); min-width: 140px; text-align: center;">
                            {{ otp }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center" style="padding-top: 10px; font-size: 13px; color: #475569; line-height: 1.5;">
                        Mã hết hạn tại
                        <span style="font-weight: 700; color: #0f172a;">
                            {{ expired_at.strftime('%H:%M, %d/%m/%Y') }}
                        </span>
                    </td>
                </tr>
            </table>
            {% endif %}

            <!-- WARNING -->
            {% if password is defined %}
            <p style="margin: 24px 0 0; font-size: 13px; font-weight: 600; color: #dc2626; line-height: 1.5;">
                ⚠️ Nếu bạn không yêu cầu đặt lại mật khẩu, vui lòng bỏ qua email này.
            </p>
            {% elif otp is defined %}
            <p style="margin: 24px 0 0; font-size: 13px; font-weight: 600; color: #dc2626; line-height: 1.5;">
                ⚠️ Vui lòng không chia sẻ mã OTP này với bất kỳ ai.
            </p>
            {% endif %}
        </td>
    </tr>

    <!-- FOOTER -->
    <tr>
        <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 24px 20px; text-align: center; color: #64748b; font-size: 13px; line-height: 1.6;">
            <div style="font-weight: 700; color: #1e293b; font-size: 14px; margin-bottom: 4px;">
                Event Tracking System
            </div>
            <div style="margin-bottom: 8px; font-size: 12px; color: #94a3b8;">
                Hệ thống quản lý và điểm danh sự kiện
            </div>
            <div style="font-size: 12px; color: #94a3b8;">
                {% if password is defined %}
                Bạn nhận được email này vì đã yêu cầu đặt lại mật khẩu.
                {% elif otp is defined %}
                Bạn nhận được email này vì đang thực hiện xác nhận OTP.
                {% endif %}
                Nếu có thắc mắc, vui lòng liên hệ ban tổ chức.
            </div>
        </td>
    </tr>
</table>
