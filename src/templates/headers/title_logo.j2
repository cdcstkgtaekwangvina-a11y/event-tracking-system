<div class="des-block" x-data>
    <img x-show="$store.screen.isMobile === false" style="width: 90px;" class="logo"
        src="{{ url_for('static', path='assets/app_logo.png') }}" alt="logo">
    <img x-show="$store.screen.isMobile" class="logo" style="width: 150px;"
        src="{{ url_for('static', path='assets/logo.png') }}" alt="logo">
    <div class="text-block" x-show="$store.screen.isMobile === false">
        <h2>Event tracking system</h2>
        <p>Hệ thống quản lý điểm danh sự kiện</p>
    </div>
</div>

<style>
    .des-block {
        display: flex;
        align-items: center;
        justify-content: left;
        gap: 10px;

    }

    .logo {
        height: auto;
        object-fit: contain;
        object-position: center;
    }

    .text-block {
        display: flex;
        flex-direction: column;
        margin-top: 0;
    }

    .text-block h2 {
        margin: 0;
        color: var(--foreground);
    }

    .text-block p {
        margin: 0;
        font-size: 15px;
        color: var(--text-secondary);
    }
</style>