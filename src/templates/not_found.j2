{% extends "templates/layouts/main.j2" %}
{% block title %}Không tồn tại{% endblock %}
{%block body %}
{% include "templates/headers/index.j2" %}
<link rel="stylesheet" href="/static/css/error.css">

<div class="error-page-container">
    <div class="error-content">
        <h1 class="error-code">
            4
            <div class="zero-circle">
                <span class="material-symbols-outlined compass-icon">explore</span>
            </div>
            4
        </h1>
        <h2 class="error-title">Trang không tồn tại</h2>
        <p class="error-description">
            Trang bạn đang tìm kiếm đã bị xoá, đổi tên, hoặc chưa từng tồn tại.<br>Hãy kiểm tra lại đường dẫn hoặc quay về trang chủ.
        </p>
        
        <div class="error-actions">
            <a class="btn btn-primary" href="{{ url_for('home') }}">
                <span class="material-symbols-outlined">home</span>
                Về trang chủ
            </a>
            <button class="btn btn-outline" onclick="window.history.back()">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại
            </button>
        </div>
    </div>
</div>


{% endblock %}