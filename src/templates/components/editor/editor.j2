<link rel="stylesheet" href="/static/css/editor/editor.css">

<div class="editor-wrapper" x-data="editorApp()" x-init="initEditor($el)"
    @tiptap-selection-change.window="$event.detail.version = Date.now()">
    <!-- Drag Handle Gutter Icon -->
    <div class="drag-handle" x-show="dragHandle.visible" :style="`top: ${dragHandle.top}px; left: ${dragHandle.left}px`"
        @mousedown="dragHandle.onMouseDown($event)" @mouseup="dragHandle.onMouseUp($event)" draggable="true"
        @dragstart="dragHandle.onDragStart($event)" @dragend="dragHandle.onDragEnd($event)"
        title="Kéo để di chuyển khối">
        ⠿
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
        <!-- Undo/Redo -->
        <div class="btn-group">
            <button type="button" class="btn" title="Hoàn tác"
                @click="myEditor.chain().focus().undo().run()">↩️</button>
            <button type="button" class="btn" title="Làm lại" @click="myEditor.chain().focus().redo().run()">↪️</button>
        </div>
        <div class="divider"></div>

        <!-- Basic Styling -->
        <div class="btn-group">
            <button type="button" class="btn" :class="isActive('bold') && 'active'" title="In đậm"
                @click="myEditor.chain().focus().toggleBold().run()"><b>B</b></button>
            <button type="button" class="btn" :class="isActive('italic') && 'active'" title="In nghiêng"
                @click="myEditor.chain().focus().toggleItalic().run()"><i>I</i></button>
            <button type="button" class="btn" :class="isActive('underline') && 'active'" title="Gạch chân"
                @click="myEditor.chain().focus().toggleUnderline().run()"><u>U</u></button>
            <button type="button" class="btn" :class="isActive('strike') && 'active'" title="Gạch ngang chữ"
                @click="myEditor.chain().focus().toggleStrike().run()"><del>S</del></button>
        </div>
        <div class="divider"></div>

        <!-- Header Levels Dropdown -->
        {% include "templates/components/editor/heading_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Alignment Dropdown -->
        {% include "templates/components/editor/align_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Custom Lists Dropdown -->
        {% include "templates/components/editor/list_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Table Selector and Operations -->
        {% include "templates/components/editor/table_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Text Colors & Highlights -->
        {% include "templates/components/editor/color_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Link Dialog -->
        {% include "templates/components/editor/link_popover.j2" %}
        <div class="divider"></div>

        <!-- Emoji Picker -->
        {% include "templates/components/editor/emoji_popover.j2" %}
        <div class="divider"></div>

        <!-- Horizontal line -->
        <button type="button" class="btn" title="Kẻ ngang phân trang"
            @click="myEditor.chain().focus().setHorizontalRule().run()">➖ Ngang</button>

        <div style="flex-grow: 1;"></div>

        <!-- Media Upload -->
        <button type="button" class="btn-media" title="Thêm Media từ tệp của bạn" @click="openMediaPicker()">
            📂 Thêm Media
        </button>
    </div>

    <!-- Editor Content Area -->
    <div class="editor-container">
        <div id="editor"></div>
    </div>

    <!-- Media Picker Modal -->
    <div class="media-picker-modal" x-show="mediaPicker.open" x-cloak
        @keydown.escape.window="mediaPicker.open && closeMediaPicker()">
        <div class="media-picker-backdrop" @click="closeMediaPicker()"></div>
        <div class="media-picker-dialog" @click.stop>
            <div class="media-picker-header">
                <div>
                    <h3>Chọn media</h3>
                    <p
                        x-text="mediaPicker.folderId ? 'Đang xem thư mục con' : 'Chọn ảnh, video hoặc file để chèn vào bài viết'">
                    </p>
                </div>
                <div class="media-picker-header-actions">
                    <button type="button" class="media-picker-nav-btn" @click="goBackInPicker()"
                        :disabled="mediaPicker.loading || !mediaPicker.folderStack.length">
                        Quay lại
                    </button>
                    <button type="button" class="media-picker-nav-btn" @click="goToPickerRoot()"
                        :disabled="mediaPicker.loading">
                        Trang đầu
                    </button>
                    <button type="button" class="media-picker-nav-btn material-symbols-outlined"
                        @click="viewMode = viewMode === 'grid' ? 'list' : 'grid'; window.dispatchEvent(new CustomEvent('view-mode-changed', { detail: { mode: viewMode } }))">
                        <span x-text="viewMode === 'grid' ? 'view_list' : 'grid_view'"></span>
                    </button>
                    <button type="button" class="media-picker-close-btn" @click="closeMediaPicker()">×</button>
                </div>
            </div>
            <div class="media-picker-toolbar">
                <div class="media-picker-search">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" placeholder="Tìm kiếm file và thư mục..." x-model="mediaPicker.search"
                        @keydown.enter.prevent="loadMediaPicker(mediaPicker.folderId)">
                </div>
                <div class="media-picker-toolbar-actions">
                    <input type="file" x-ref="pickerFileInput" class="media-picker-hidden-input"
                        @change="onPickerFileSelected($event)">
                    <button type="button" class="media-picker-nav-btn media-picker-upload-btn"
                        :disabled="mediaPicker.uploading" @click="triggerPickerUpload()">
                        <span class="material-symbols-outlined" x-show="!mediaPicker.uploading">upload</span>
                        <span class="spinner-inline" x-show="mediaPicker.uploading"></span>
                        <span x-text="mediaPicker.uploading ? 'Đang tải' : 'Tải lên'"></span>
                    </button>
                    <div class="media-picker-dropdown" @click.outside="mediaPicker.filterOpen = false">
                        <button type="button" class="media-picker-nav-btn"
                            @click="mediaPicker.filterOpen = !mediaPicker.filterOpen">
                            <span
                                x-text="mediaPicker.filterValue === 'all' ? 'Tất cả' : mediaPicker.filterValue === 'image' ? 'Hình ảnh' : mediaPicker.filterValue === 'video' ? 'Video' : mediaPicker.filterValue === 'audio' ? 'Âm thanh' : mediaPicker.filterValue === 'document' ? 'Tài liệu' : mediaPicker.filterValue === 'folder' ? 'Thư mục' : 'Khác'"></span>
                            <span class="material-symbols-outlined">expand_more</span>
                        </button>
                        <div class="media-picker-menu" x-show="mediaPicker.filterOpen" x-transition.opacity>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'all'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Tất
                                cả</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'image'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Hình
                                ảnh</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'video'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Video</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'audio'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Âm
                                thanh</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'document'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Tài
                                liệu</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'folder'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Thư
                                mục</button>
                            <button type="button"
                                @click="mediaPicker.filterValue = 'other'; mediaPicker.filterOpen = false; loadMediaPicker(mediaPicker.folderId)">Khác</button>
                        </div>
                    </div>
                    <div class="media-picker-dropdown" @click.outside="mediaPicker.sortOpen = false">
                        <button type="button" class="media-picker-nav-btn"
                            @click="mediaPicker.sortOpen = !mediaPicker.sortOpen">
                            <span
                                x-text="mediaPicker.sortValue === 'name' ? 'Tên' : mediaPicker.sortValue === 'created_at' ? 'Ngày tạo' : mediaPicker.sortValue === 'updated_at' ? 'Ngày sửa đổi' : 'Tên'"></span>
                            <span x-text="mediaPicker.sortDir === 'desc' ? '↓' : '↑'"></span>
                        </button>
                        <div class="media-picker-menu" x-show="mediaPicker.sortOpen" x-transition.opacity>
                            <button type="button"
                                @click="mediaPicker.sortValue = 'name'; mediaPicker.sortOpen = false; loadMediaPicker(mediaPicker.folderId)">Tên</button>
                            <button type="button"
                                @click="mediaPicker.sortValue = 'created_at'; mediaPicker.sortOpen = false; loadMediaPicker(mediaPicker.folderId)">Ngày
                                tạo</button>
                            <button type="button"
                                @click="mediaPicker.sortValue = 'updated_at'; mediaPicker.sortOpen = false; loadMediaPicker(mediaPicker.folderId)">Ngày
                                sửa đổi</button>
                            <div class="media-picker-menu-divider"></div>
                            <button type="button"
                                @click="mediaPicker.sortDir = mediaPicker.sortDir === 'asc' ? 'desc' : 'asc'; mediaPicker.sortOpen = false; loadMediaPicker(mediaPicker.folderId)">
                                <span x-text="mediaPicker.sortDir === 'asc' ? 'Tăng dần' : 'Giảm dần'"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="media-picker-body">
                <div class="media-picker-main">
                    <div class="media-picker-status" x-show="mediaPicker.loading">
                        <div class="spinner-sm"></div>
                        <span>Đang tải media...</span>
                    </div>
                    <div class="media-body media-picker-items" id="editor-media-picker-items"
                        :class="{ 'is-loading': mediaPicker.loading }">
                        <div class="media-loading" x-show="mediaPicker.loading">
                            <div class="spinner-sm"></div>
                            <span>Đang tải dữ liệu...</span>
                        </div>
                    </div>
                </div>
                <aside class="media-picker-sidebar">
                    <template x-if="mediaPicker.selected">
                        <div class="media-picker-detail">
                            <div class="media-picker-preview">
                                <template x-if="mediaPicker.selected.kind === 'folder'">
                                    <span class="material-symbols-outlined media-picker-folder-icon">folder</span>
                                </template>
                                <template
                                    x-if="mediaPicker.selected.kind === 'file' && mediaPicker.selected.type === 'image' && mediaPicker.selected.url">
                                    <img :src="mediaPicker.selected.url" :alt="mediaPicker.selected.name" />
                                </template>
                                <template
                                    x-if="mediaPicker.selected.kind === 'file' && mediaPicker.selected.type === 'video' && mediaPicker.selected.url">
                                    <video :src="mediaPicker.selected.url" controls></video>
                                </template>
                                <template
                                    x-if="mediaPicker.selected.kind === 'file' && mediaPicker.selected.type === 'audio' && mediaPicker.selected.url">
                                    <audio :src="mediaPicker.selected.url" controls></audio>
                                </template>
                                <template
                                    x-if="mediaPicker.selected.kind === 'file' && (!mediaPicker.selected.type || (mediaPicker.selected.type !== 'image' && mediaPicker.selected.type !== 'video' && mediaPicker.selected.type !== 'audio'))">
                                    <span class="material-symbols-outlined media-picker-file-icon">description</span>
                                </template>
                            </div>
                            <div class="media-picker-fields">
                                <div class="media-picker-field">
                                    <span class="label">Tên</span>
                                    <span class="value" x-text="mediaPicker.selected.name"></span>
                                </div>
                                <div class="media-picker-field">
                                    <span class="label">URL</span>
                                    <div class="media-picker-url-row">
                                        <span class="value media-picker-url"
                                            x-text="mediaPicker.selected.url || '—'"></span>
                                        <button type="button" class="media-picker-copy-btn"
                                            x-show="mediaPicker.selected.url" @click="copyMediaUrl()">
                                            Copy
                                        </button>
                                    </div>
                                </div>
                                <div class="media-picker-field">
                                    <span class="label">Kích thước</span>
                                    <span class="value" x-text="mediaPicker.selected.sizeLabel || '—'"></span>
                                </div>
                                <div class="media-picker-field">
                                    <span class="label">Loại</span>
                                    <span class="value"
                                        x-text="mediaPicker.selected.kind === 'folder' ? 'Thư mục' : (mediaPicker.selected.type === 'audio' ? 'Âm thanh' : (mediaPicker.selected.type || 'File khác'))"></span>
                                </div>
                                <div class="media-picker-field">
                                    <span class="label">Định dạng</span>
                                    <span class="value" x-text="mediaPicker.selected.format || '—'"></span>
                                </div>
                            </div>
                            <div class="media-picker-actions">
                                <button type="button" class="media-picker-primary" :disabled="!canInsertSelectedMedia()"
                                    @click="insertSelectedMedia()">
                                    Xác nhận chèn
                                </button>
                            </div>
                        </div>
                    </template>
                    <template x-if="!mediaPicker.selected">
                        <div class="media-picker-empty">
                            <span class="material-symbols-outlined">photo_library</span>
                            <p>Chọn một file để xem thông tin ở đây.</p>
                        </div>
                    </template>
                </aside>
            </div>
        </div>
    </div>

    <!-- Floating Menu (appears on empty lines) -->
    <div class="floating-menu" x-show="floatingMenu.visible"
        :style="`top: ${floatingMenu.top}px; left: ${floatingMenu.left}px`"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 transform translate-y-1"
        x-transition:enter-end="opacity-100 transform translate-y-0" @mousedown.prevent>
        <button type="button" class="fm-btn" title="Tiêu đề 1"
            @click="myEditor.chain().focus().toggleHeading({ level: 1 }).run()">📌 H1</button>
        <button type="button" class="fm-btn" title="Tiêu đề 2"
            @click="myEditor.chain().focus().toggleHeading({ level: 2 }).run()">📎 H2</button>
        <button type="button" class="fm-btn" title="Tiêu đề 3"
            @click="myEditor.chain().focus().toggleHeading({ level: 3 }).run()">🔖 H3</button>
        <div class="fm-divider"></div>
        <button type="button" class="fm-btn" title="Danh sách chấm"
            @click="myEditor.chain().focus().toggleBulletList().run()">• DS chấm</button>
        <button type="button" class="fm-btn" title="Danh sách số"
            @click="myEditor.chain().focus().toggleOrderedList().run()">1. DS số</button>
        <div class="fm-divider"></div>
        <button type="button" class="fm-btn" title="Bảng 3x3"
            @click="myEditor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()">📊
            Bảng</button>
        <button type="button" class="fm-btn" title="Đường kẻ ngang"
            @click="myEditor.chain().focus().setHorizontalRule().run()">➖ Ngang</button>
    </div>

    <!-- Media floating toolbar -->
    <div class="media-floating-menu" x-show="mediaToolbar.visible" x-cloak
        :style="`top: ${mediaToolbar.top}px; left: ${mediaToolbar.left}px`">
        <button type="button" class="fm-btn" title="Căn trái" @click="setSelectedMediaAlign('left')">
            <span class="material-symbols-outlined">format_align_left</span>
        </button>
        <button type="button" class="fm-btn" title="Căn giữa" @click="setSelectedMediaAlign('center')">
            <span class="material-symbols-outlined">format_align_center</span>
        </button>
        <button type="button" class="fm-btn" title="Căn phải" @click="setSelectedMediaAlign('right')">
            <span class="material-symbols-outlined">format_align_right</span>
        </button>
        <template x-if="mediaToolbar.type !== 'audio'">
            <div style="display: contents;">
                <div class="fm-divider"></div>
                <button type="button" class="fm-btn" title="Thu nhỏ" @click="resizeSelectedMedia(-40)">
                    <span class="material-symbols-outlined">zoom_in_map</span>
                </button>
                <button type="button" class="fm-btn" title="Phóng to" @click="resizeSelectedMedia(40)">
                    <span class="material-symbols-outlined">zoom_out_map</span>
                </button>
            </div>
        </template>
    </div>
</div>

<script>
    // Defining the Alpine.js editorApp logic synchronously to prevent race conditions during Alpine's DOM initialization
    window.editorApp = function () {
        return {
            activeDropdown: null,
            emojiActiveTab: 'smileys',
            url: '',
            newTab: true,
            viewMode: localStorage.getItem('mediaViewMode') || 'grid',
            mediaPicker: {
                open: false,
                loading: false,
                uploading: false,
                folderId: '',
                folderStack: [],
                selected: null,
                search: '',
                filterValue: 'all',
                filterOpen: false,
                sortValue: 'updated_at',
                sortOpen: false,
                sortDir: 'desc',
                maxUploadSizeBytes: null,
            },
            floatingMenu: {
                visible: false,
                top: 0,
                left: 0,
            },
            mediaToolbar: {
                visible: false,
                top: 0,
                left: 0,
                type: null,
            },
            init() {
                this.$watch('viewMode', (val) => localStorage.setItem('mediaViewMode', val));
                window.editorMediaPicker = this;
            },
            tableGrid: {
                hoveredRow: 0,
                hoveredCol: 0,
                reset() {
                    this.hoveredRow = 0;
                    this.hoveredCol = 0;
                },
                hover(r, c) {
                    this.hoveredRow = r;
                    this.hoveredCol = c;
                },
                click(r, c) {
                    if (window.myEditor) {
                        window.myEditor.chain().focus().insertTable({ rows: r, cols: c, withHeaderRow: true }).run();
                    }
                }
            },
            formatBytes(bytes) {
                const value = Number(bytes);
                if (!Number.isFinite(value) || value <= 0) return '—';
                if (value >= 1073741824) return `${(value / 1073741824).toFixed(1)} GB`;
                if (value >= 1048576) return `${(value / 1048576).toFixed(1)} MB`;
                if (value >= 1024) return `${(value / 1024).toFixed(1)} KB`;
                return `${value} B`;
            },
            async ensureUploadLimit() {
                if (this.mediaPicker.maxUploadSizeBytes !== null) return this.mediaPicker.maxUploadSizeBytes;
                try {
                    const res = await window.fetchHelper.get('setting/max_file_sizes');
                    const candidate = res?.data?.value?.max_size_file;
                    const raw = typeof candidate === 'object' ? Object.values(candidate)[0] : candidate;
                    const size = Number(raw);
                    this.mediaPicker.maxUploadSizeBytes = Number.isFinite(size) && size > 0 ? size : 50 * 1024 * 1024;
                } catch (error) {
                    console.error(error);
                    this.mediaPicker.maxUploadSizeBytes = 50 * 1024 * 1024;
                }
                return this.mediaPicker.maxUploadSizeBytes;
            },
            async copyMediaUrl() {
                const url = this.mediaPicker.selected?.url;
                if (!url) return;
                try {
                    await navigator.clipboard.writeText(url);
                    window.notify?.toast?.success?.('Thành công', 'Đã sao chép URL');
                } catch (error) {
                    console.error(error);
                    window.notify?.toast?.error?.('Lỗi', 'Không thể sao chép URL');
                }
            },
            syncPickerSelectionClasses() {
                const container = document.getElementById('editor-media-picker-items');
                if (!container) return;
                const selectedId = this.mediaPicker.selected?.id;
                container.querySelectorAll('.media-row, .media-grid-card').forEach((el) => {
                    el.classList.toggle('selected', !!selectedId && parseInt(el.dataset.id) === selectedId);
                });
            },
            async loadMediaPicker(folderId = '', pushHistory = false) {
                const container = document.getElementById('editor-media-picker-items');
                if (!container) return;

                if (pushHistory && this.mediaPicker.folderId) {
                    this.mediaPicker.folderStack.push(this.mediaPicker.folderId);
                }

                this.mediaPicker.loading = true;
                this.mediaPicker.folderId = folderId || '';
                this.mediaPicker.selected = null;

                const params = new URLSearchParams();
                params.set('picker', 'true');
                params.set('limit', '60');
                if (this.mediaPicker.folderId) {
                    params.set('folder_id', this.mediaPicker.folderId);
                }
                if (this.mediaPicker.search) {
                    params.set('search', this.mediaPicker.search);
                }
                if (this.mediaPicker.filterValue && this.mediaPicker.filterValue !== 'all') {
                    params.set('type_filter', this.mediaPicker.filterValue);
                }
                if (this.mediaPicker.sortValue) {
                    params.set('sort_field', this.mediaPicker.sortValue);
                    params.set('is_desc', this.mediaPicker.sortDir === 'desc' ? 'true' : 'false');
                }

                const url = "{{ url_for('media_manager') }}/items/html?" + params.toString();
                container.innerHTML = '<div class="media-loading"><div class="spinner-sm"></div><span>Đang tải dữ liệu...</span></div>';
                try {
                    await htmx.ajax('GET', url, { target: '#editor-media-picker-items', swap: 'innerHTML' });
                } finally {
                    this.mediaPicker.loading = false;
                    this.syncPickerSelectionClasses();
                }
            },
            openMediaPicker() {
                this.mediaPicker.open = true;
                this.mediaPicker.folderId = '';
                this.mediaPicker.folderStack = [];
                this.mediaPicker.selected = null;
                this.mediaPicker.search = '';
                this.mediaPicker.filterValue = 'all';
                this.mediaPicker.sortValue = 'updated_at';
                this.mediaPicker.sortDir = 'desc';
                this.loadMediaPicker('');
            },
            closeMediaPicker() {
                this.mediaPicker.open = false;
            },
            goToPickerRoot() {
                this.mediaPicker.folderStack = [];
                this.loadMediaPicker('');
            },
            goBackInPicker() {
                const previousFolderId = this.mediaPicker.folderStack.pop();
                this.loadMediaPicker(previousFolderId || '');
            },
            handleItemClick(event) {
                const itemEl = event.currentTarget.closest('.media-row, .media-grid-card');
                if (!itemEl) return;

                const kind = itemEl.dataset.mediaKind || itemEl.dataset.type || 'file';
                const folderId = itemEl.dataset.id;
                if (kind === 'folder') {
                    this.loadMediaPicker(folderId, true);
                    return;
                }

                this.mediaPicker.selected = {
                    id: parseInt(itemEl.dataset.id),
                    name: itemEl.dataset.mediaName || '',
                    url: itemEl.dataset.mediaUrl || '',
                    kind,
                    type: itemEl.dataset.mediaType || '',
                    format: itemEl.dataset.mediaFormat || '',
                    size: itemEl.dataset.mediaSize || '',
                    sizeLabel: this.formatBytes(itemEl.dataset.mediaSize),
                };
                this.syncPickerSelectionClasses();
            },
            canInsertSelectedMedia() {
                return !!(this.mediaPicker.selected && this.mediaPicker.selected.kind !== 'folder' && this.mediaPicker.selected.url);
            },
            insertSelectedMedia() {
                const selected = this.mediaPicker.selected;
                if (!selected || !selected.url || selected.kind === 'folder' || !window.myEditor) return;

                const name = selected.name || selected.url.split('/').pop() || 'media';
                const url = selected.url;
                if (selected.type === 'image') {
                    window.myEditor.chain().focus().setImage({ src: url, alt: name, title: name, align: 'center', width: '100%' }).run();
                } else if (selected.type === 'video') {
                    window.myEditor.chain().focus().insertContent({
                        type: 'video',
                        attrs: { src: url, controls: true, title: name, align: 'center', width: '100%' }
                    }).run();
                } else if (selected.type === 'audio') {
                    window.myEditor.chain().focus().insertContent({
                        type: 'audio',
                        attrs: { src: url, title: name, align: 'center' }
                    }).run();
                } else {
                    window.myEditor.chain().focus().insertContent({
                        type: 'text',
                        text: name,
                        marks: [{ type: 'link', attrs: { href: url, target: '_blank' } }]
                    }).run();
                }
                this.closeMediaPicker();
            },
            setSelectedMediaAlign(align) {
                if (!window.myEditor) return;
                const node = window.myEditor.state.selection?.node;
                const typeName = node?.type?.name;
                if (!['image', 'video', 'audio'].includes(typeName)) return;
                window.myEditor.chain().focus().updateAttributes(typeName, { align }).run();
            },
            resizeSelectedMedia(delta) {
                if (!window.myEditor) return;
                const node = window.myEditor.state.selection?.node;
                const typeName = node?.type?.name;
                if (!['image', 'video'].includes(typeName)) return;
                const currentWidth = parseInt(String(node.attrs.width || '').replace(/px$/, ''), 10);
                const nextWidth = Math.max(160, (Number.isFinite(currentWidth) ? currentWidth : 480) + delta);
                window.myEditor.chain().focus().updateAttributes(typeName, { width: `${nextWidth}px` }).run();
            },
