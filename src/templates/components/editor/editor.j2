<link rel="stylesheet" href="/static/css/editor/editor.css">

<div class="editor-wrapper" x-data="editorApp()" x-init="initEditor($el)"
    @tiptap-selection-change.window="$event.detail.version = Date.now()">
    <!-- Drag Handle Gutter Icon -->
    <div class="drag-handle" x-show="dragHandle.visible" :style="`top: ${dragHandle.top}px; left: ${dragHandle.left}px`"
        @mousedown="dragHandle.onMouseDown($event)" @mouseup="dragHandle.onMouseUp($event)" draggable="true"
        @dragstart="dragHandle.onDragStart($event)" @dragend="dragHandle.onDragEnd($event)"
        title="Kéo để di chuyển khối">
        ⠿
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
        <!-- Undo/Redo -->
        <div class="btn-group">
            <button type="button" class="btn" title="Hoàn tác"
                @click="myEditor.chain().focus().undo().run()">↩️</button>
            <button type="button" class="btn" title="Làm lại" @click="myEditor.chain().focus().redo().run()">↪️</button>
        </div>
        <div class="divider"></div>

        <!-- Basic Styling -->
        <div class="btn-group">
            <button type="button" class="btn" :class="isActive('bold') && 'active'" title="In đậm"
                @click="myEditor.chain().focus().toggleBold().run()"><b>B</b></button>
            <button type="button" class="btn" :class="isActive('italic') && 'active'" title="In nghiêng"
                @click="myEditor.chain().focus().toggleItalic().run()"><i>I</i></button>
            <button type="button" class="btn" :class="isActive('underline') && 'active'" title="Gạch chân"
                @click="myEditor.chain().focus().toggleUnderline().run()"><u>U</u></button>
            <button type="button" class="btn" :class="isActive('strike') && 'active'" title="Gạch ngang chữ"
                @click="myEditor.chain().focus().toggleStrike().run()"><del>S</del></button>
        </div>
        <div class="divider"></div>

        <!-- Header Levels Dropdown -->
        {% include "templates/components/editor/heading_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Alignment Dropdown -->
        {% include "templates/components/editor/align_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Custom Lists Dropdown -->
        {% include "templates/components/editor/list_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Table Selector and Operations -->
        {% include "templates/components/editor/table_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Text Colors & Highlights -->
        {% include "templates/components/editor/color_dropdown.j2" %}
        <div class="divider"></div>

        <!-- Link Dialog -->
        {% include "templates/components/editor/link_popover.j2" %}
        <div class="divider"></div>

        <!-- Emoji Picker -->
        {% include "templates/components/editor/emoji_popover.j2" %}
        <div class="divider"></div>

        <!-- Horizontal line -->
        <button type="button" class="btn" title="Kẻ ngang phân trang"
            @click="myEditor.chain().focus().setHorizontalRule().run()">➖ Ngang</button>

        <div style="flex-grow: 1;"></div>

        <!-- Media Upload -->
        <button type="button" class="btn-media" title="Thêm Media từ tệp của bạn"
            @click="$dispatch('open-media-modal')">
            📂 Thêm Media
        </button>
    </div>

    <!-- Editor Content Area -->
    <div class="editor-container">
        <div id="editor"></div>
    </div>

    <!-- Floating Menu (appears on empty lines) -->
    <div class="floating-menu" x-show="floatingMenu.visible"
        :style="`top: ${floatingMenu.top}px; left: ${floatingMenu.left}px`"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 transform translate-y-1"
        x-transition:enter-end="opacity-100 transform translate-y-0" @mousedown.prevent>
        <button type="button" class="fm-btn" title="Tiêu đề 1"
            @click="myEditor.chain().focus().toggleHeading({ level: 1 }).run()">📌 H1</button>
        <button type="button" class="fm-btn" title="Tiêu đề 2"
            @click="myEditor.chain().focus().toggleHeading({ level: 2 }).run()">📎 H2</button>
        <button type="button" class="fm-btn" title="Tiêu đề 3"
            @click="myEditor.chain().focus().toggleHeading({ level: 3 }).run()">🔖 H3</button>
        <div class="fm-divider"></div>
        <button type="button" class="fm-btn" title="Danh sách chấm"
            @click="myEditor.chain().focus().toggleBulletList().run()">• DS chấm</button>
        <button type="button" class="fm-btn" title="Danh sách số"
            @click="myEditor.chain().focus().toggleOrderedList().run()">1. DS số</button>
        <div class="fm-divider"></div>
        <button type="button" class="fm-btn" title="Bảng 3x3"
            @click="myEditor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()">📊
            Bảng</button>
        <button type="button" class="fm-btn" title="Đường kẻ ngang"
            @click="myEditor.chain().focus().setHorizontalRule().run()">➖ Ngang</button>
    </div>
</div>

<script>
    // Defining the Alpine.js editorApp logic synchronously to prevent race conditions during Alpine's DOM initialization
    window.editorApp = function () {
        return {
            activeDropdown: null,
            emojiActiveTab: 'smileys',
            url: '',
            newTab: true,
            floatingMenu: {
                visible: false,
                top: 0,
                left: 0,
            },
            tableGrid: {
                hoveredRow: 0,
                hoveredCol: 0,
                reset() {
                    this.hoveredRow = 0;
                    this.hoveredCol = 0;
                },
                hover(r, c) {
                    this.hoveredRow = r;
                    this.hoveredCol = c;
                },
                click(r, c) {
                    if (window.myEditor) {
                        window.myEditor.chain().focus().insertTable({ rows: r, cols: c, withHeaderRow: true }).run();
                    }
                }
            },
            dragHandle: {
                visible: false,
                top: 0,
                left: 8,
                activeBlock: null,
                draggedPos: null,
                init(editorEl, handleEl) {
                    editorEl.addEventListener('mousemove', (e) => {
                        const tiptap = editorEl.querySelector('.tiptap');
                        if (!tiptap) return;

                        // Identify the closest top-level direct child under .tiptap
                        let target = e.target;
                        while (target && target !== tiptap) {
                            if (target.parentElement === tiptap) {
                                break;
                            }
                            target = target.parentElement;
                        }

                        if (target && target !== tiptap && target.nodeType === 1) {
                            const rect = target.getBoundingClientRect();
                            const wrapperRect = editorEl.getBoundingClientRect();

                            // Align vertically next to active block and lock position left
                            this.top = rect.top - wrapperRect.top + (rect.height - 24) / 2;
                            this.activeBlock = target;
                            this.visible = true;
                        }
                    });

                    editorEl.addEventListener('mouseleave', () => {
                        setTimeout(() => {
                            if (!handleEl.matches(':hover')) {
                                this.visible = false;
                            }
                        }, 250);
                    });
                },
                onMouseDown(e) {
                    if (this.activeBlock) {
                        this.activeBlock.setAttribute('draggable', 'true');
                    }
                },
                onMouseUp(e) {
                    if (this.activeBlock) {
                        this.activeBlock.removeAttribute('draggable');
                    }
                },
                onDragStart(e) {
                    if (this.activeBlock && window.myEditor) {
                        try {
                            const pos = window.myEditor.view.posAtDOM(this.activeBlock, 0);
                            window.draggedPos = pos;
                        } catch (err) {
                            window.draggedPos = null;
                        }
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/x-tiptap-block', 'true');
                        e.dataTransfer.setData('text/html', this.activeBlock.outerHTML);
                    }
                },
                onDragEnd(e) {
                    if (this.activeBlock) {
                        this.activeBlock.removeAttribute('draggable');
                    }
                    this.visible = false;
                }
            },
            initEditor(el) {
                // Instantiated on layout creation via ESM script below
            },
            toggleDropdown(name) {
                this.activeDropdown = this.activeDropdown === name ? null : name;
            },
            closeDropdown() {
                this.activeDropdown = null;
            },
            isActive(type, attrs = {}) {
                return window.myEditor ? window.myEditor.isActive(type, attrs) : false;
            },
            getCurrentHeadingLabel() {
                if (!window.myEditor) return 'Định dạng';
                if (this.isActive('heading', { level: 1 })) return 'Tiêu đề 1';
                if (this.isActive('heading', { level: 2 })) return 'Tiêu đề 2';
                if (this.isActive('heading', { level: 3 })) return 'Tiêu đề 3';
                if (this.isActive('heading', { level: 4 })) return 'Tiêu đề 4';
                return 'Đoạn văn (P)';
            },
            getCurrentAlignLabel() {
                if (!window.myEditor) return 'Căn lề';
                if (this.isActive({ textAlign: 'center' })) return 'Căn giữa';
                if (this.isActive({ textAlign: 'right' })) return 'Căn phải';
                if (this.isActive({ textAlign: 'justify' })) return 'Căn đều';
                return 'Căn trái';
            },
            toggleOrderedList(type) {
                if (window.myEditor) {
                    if (!window.myEditor.isActive('orderedList')) {
                        window.myEditor.chain().focus().toggleOrderedList().run();
                    }
                    window.myEditor.chain().focus().updateAttributes('orderedList', { listStyleType: type }).run();
                }
            },
            toggleBulletList(type) {
                if (window.myEditor) {
                    if (!window.myEditor.isActive('bulletList')) {
                        window.myEditor.chain().focus().toggleBulletList().run();
                    }
                    window.myEditor.chain().focus().updateAttributes('bulletList', { listStyleType: type }).run();
                }
            },
            saveLink(url, newTab) {
                if (window.myEditor) {
                    if (url) {
                        window.myEditor.chain().focus().extendMarkRange('link').setLink({ href: url, target: newTab ? '_blank' : null }).run();
                    } else {
                        window.myEditor.chain().focus().extendMarkRange('link').unsetLink().run();
                    }
                }
            }
        };
    };

</script>

<script type="module">
    import {
        Editor, StarterKit, Image, TableKit, Underline, Highlight, TextStyle, Color,
        TextAlign, Link, Dropcursor, OrderedList, BulletList, Placeholder
    } from '/static/js/vendors/tiptap.js';

    // Extend OrderedList and BulletList to support custom styling types
    const CustomOrderedList = OrderedList.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                listStyleType: {
                    default: 'decimal',
                    parseHTML: element => element.style.listStyleType || 'decimal',
                    renderHTML: attributes => {
                        if (!attributes.listStyleType) return {};
                        return { style: `list-style-type: ${attributes.listStyleType}` };
                    },
                },
            };
        },
    });

    const CustomBulletList = BulletList.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                listStyleType: {
                    default: 'disc',
                    parseHTML: element => element.style.listStyleType || 'disc',
                    renderHTML: attributes => {
                        if (!attributes.listStyleType) return {};
                        return { style: `list-style-type: ${attributes.listStyleType}` };
                    },
                },
            };
        },
    });

    // Instantiate TipTap
    const editor = new Editor({
        element: document.querySelector('#editor'),
        editorProps: {
            handleDrop(view, event, slice, moved) {
                if (event.dataTransfer.getData('text/x-tiptap-block')) {
                    const coordinates = view.posAtCoords({ left: event.clientX, top: event.clientY });
                    if (coordinates) {
                        const fromInsidePos = window.draggedPos;
                        if (fromInsidePos !== null && fromInsidePos !== undefined) {
                            try {
                                const $fromPos = view.state.doc.resolve(fromInsidePos);
                                const fromPos = $fromPos.before(1);
                                const node = view.state.doc.nodeAt(fromPos);

                                if (node) {
                                    const $targetPos = view.state.doc.resolve(coordinates.pos);
                                    const targetBlockPos = $targetPos.before(1);

                                    // Same block — no-op
                                    if (fromPos === targetBlockPos) {
                                        event.preventDefault();
                                        return true;
                                    }

                                    const tr = view.state.tr;
                                    // Delete source node first
                                    tr.delete(fromPos, fromPos + node.nodeSize);
                                    // Use tr.mapping.map() to get the correct position after delete
                                    let mappedInsertPos;
                                    if (targetBlockPos > fromPos) {
                                        // Moving down: insert after target block
                                        mappedInsertPos = tr.mapping.map($targetPos.after(1));
                                    } else {
                                        // Moving up: insert before target block
                                        mappedInsertPos = tr.mapping.map(targetBlockPos);
                                    }
                                    tr.insert(mappedInsertPos, node);
                                    view.dispatch(tr);

                                    event.preventDefault();
                                    return true;
                                }
                            } catch (err) {
                                console.error('Error during block move:', err);
                            }
                        }
                    }
                }
                return false;
            }
        },
        extensions: [
            StarterKit.configure({
                orderedList: false,
                bulletList: false,
                dropcursor: false,
            }),
            CustomOrderedList,
            CustomBulletList,
            Image,
            TableKit.configure({
                table: { resizable: true },
            }),
            //Underline,
            Highlight.configure({
                multicolor: true,
            }),
            TextStyle,
            Color,
            TextAlign.configure({
                types: ['heading', 'paragraph'],
            }),
            {# Link.configure({
                openOnClick: false,
                HTMLAttributes: {
                    class: 'editor-link',
                }
            }), #}
            Dropcursor.configure({
                color: '#3b82f6',
                width: 2,
            }),
            Placeholder.configure({
                emptyEditorClass: 'is-editor-empty',
                placeholder: 'Nhập nội dung tại đây 1223...',
            }),
        ],

        onSelectionUpdate({ editor }) {
            const event = new CustomEvent('tiptap-selection-change', { detail: { editor } });
            window.dispatchEvent(event);
            updateFloatingMenu(editor);
        },
        onUpdate({ editor }) {
            const event = new CustomEvent('tiptap-selection-change', { detail: { editor } });
            window.dispatchEvent(event);
            updateFloatingMenu(editor);
        }
    });

    function getContent() {
        editor.getJSON()
    }

    function importContent(content) {
        const jsonObject = typeof content === 'string' ? JSON.parse(content) : content;

        editor.commands.setContent(jsonObject, { contentType: 'json' });
    }

    window.myEditor = { ...editor, ...{ getContent: getContent, importContent: importContent } };

    // Floating menu: show on empty paragraphs
    function updateFloatingMenu(ed) {
        const wrapper = document.querySelector('.editor-wrapper');
        if (!wrapper || !window.Alpine) return;
        const alpineData = window.Alpine.$data(wrapper);
        if (!alpineData) return;

        const { state } = ed;
        const { $from } = state.selection;
        const isEmptyParagraph = $from.parent.isTextblock
            && $from.parent.content.size === 0
            && $from.parent.type.name === 'paragraph';

        if (isEmptyParagraph && state.selection.empty) {
            try {
                const coords = ed.view.coordsAtPos($from.pos);
                const wrapperRect = wrapper.getBoundingClientRect();
                alpineData.floatingMenu.top = coords.top - wrapperRect.top + 24;
                alpineData.floatingMenu.left = coords.left - wrapperRect.left;
                alpineData.floatingMenu.visible = true;
            } catch (e) {
                alpineData.floatingMenu.visible = false;
            }
        } else {
            alpineData.floatingMenu.visible = false;
        }
    }

    // Set Alpine editor references after loading
    document.addEventListener('alpine:init', () => {
        // Alpine bound reactive properties
    });

    // Access alpine component variables to wire drag handle
    setTimeout(() => {
        const editorWrapper = document.querySelector('.editor-wrapper');
        const dragHandleEl = document.querySelector('.drag-handle');
        if (editorWrapper && dragHandleEl && window.Alpine) {
            const alpineData = window.Alpine.$data(editorWrapper);
            if (alpineData && alpineData.dragHandle) {
                alpineData.dragHandle.init(editorWrapper, dragHandleEl);
            }
        }
    }, 100);
</script>