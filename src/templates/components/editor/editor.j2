<script type="module">
    import {
        Editor, Node, StarterKit, Image, TableKit, Underline, Highlight, TextStyle, Color,
        TextAlign, Link, Dropcursor, OrderedList, BulletList, Placeholder
    } from '/static/js/vendors/tiptap.js';

    // Extend OrderedList and BulletList to support custom styling types
    const CustomOrderedList = OrderedList.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                listStyleType: {
                    default: 'decimal',
                    parseHTML: element => element.style.listStyleType || 'decimal',
                    renderHTML: attributes => {
                        if (!attributes.listStyleType) return {};
                        return { style: `list-style-type: ${attributes.listStyleType}` };
                    },
                },
            };
        },
    });

    const CustomBulletList = BulletList.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                listStyleType: {
                    default: 'disc',
                    parseHTML: element => element.style.listStyleType || 'disc',
                    renderHTML: attributes => {
                        if (!attributes.listStyleType) return {};
                        return { style: `list-style-type: ${attributes.listStyleType}` };
                    },
                },
            };
        },
    });

    const createResizableMediaNodeView = (typeName) => {
        return ({ node, editor, getPos }) => {
            let currentNode = node;
            let currentWidth = node.attrs.width || '100%';
            let currentAlign = node.attrs.align || 'center';
            let resizeState = null;

            const wrapper = document.createElement('figure');
            wrapper.className = `media-resizable media-resizable--${typeName}`;
            wrapper.contentEditable = 'false';
            wrapper.draggable = true;
            wrapper.style.position = 'relative';
            wrapper.style.overflow = 'visible';

            const mediaEl = document.createElement(typeName === 'image' ? 'img' : 'video');
            mediaEl.className = 'media-resizable__media';
            if (typeName === 'video') {
                mediaEl.controls = true;
            }

            const chrome = document.createElement('div');
            chrome.className = 'media-resizable__chrome';
            const handleMap = [
                'nw', 'n', 'ne',
                'w', 'e',
                'sw', 's', 'se'
            ];
            handleMap.forEach((position) => {
                const handleEl = document.createElement('span');
                handleEl.className = `media-resizable__corner media-resizable__corner--${position}`;
                handleEl.dataset.handle = position;
                chrome.appendChild(handleEl);
            });

            wrapper.append(mediaEl, chrome);

            const readWidthPx = () => {
                const parsed = parseInt(String(currentWidth || '').replace(/px$/, ''), 10);
                if (Number.isFinite(parsed) && parsed > 0) return parsed;
                const fallback = wrapper.parentElement?.clientWidth ? Math.floor(wrapper.parentElement.clientWidth * 0.6) : 480;
                return fallback;
            };

            const getBoxRect = () => wrapper.getBoundingClientRect();

            const resizeFromHandle = (handle, deltaX, deltaY, baseWidth, aspectRatio) => {
                const horizontal = handle.includes('e') ? deltaX : handle.includes('w') ? -deltaX : 0;
                const vertical = handle.includes('s') ? deltaY : handle.includes('n') ? -deltaY : 0;
                const verticalAsWidth = Number.isFinite(aspectRatio) && aspectRatio > 0 ? vertical * aspectRatio : vertical;

                let nextWidth = baseWidth;
                if (horizontal !== 0 && verticalAsWidth !== 0) {
                    nextWidth = baseWidth + (Math.abs(horizontal) >= Math.abs(verticalAsWidth) ? horizontal : verticalAsWidth);
                } else if (horizontal !== 0) {
                    nextWidth = baseWidth + horizontal;
                } else if (verticalAsWidth !== 0) {
                    nextWidth = baseWidth + verticalAsWidth;
                }

                return Math.max(160, Math.round(nextWidth));
            };

            const applyState = () => {
                currentWidth = currentNode.attrs.width || '100%';
                currentAlign = currentNode.attrs.align || 'center';
                const widthValue = String(currentWidth);
                wrapper.dataset.align = currentAlign;
                wrapper.style.width = widthValue;
                wrapper.style.maxWidth = '100%';
                wrapper.style.display = 'block';
                wrapper.style.marginLeft = currentAlign === 'left' ? '0' : 'auto';
                wrapper.style.marginRight = currentAlign === 'right' ? '0' : 'auto';
                if (typeName === 'image') {
                    mediaEl.src = currentNode.attrs.src || '';
                    mediaEl.alt = currentNode.attrs.alt || '';
                    mediaEl.title = currentNode.attrs.title || '';
                } else {
                    mediaEl.src = currentNode.attrs.src || '';
                    mediaEl.title = currentNode.attrs.title || '';
                }
                mediaEl.style.width = '100%';
                mediaEl.style.height = 'auto';
            };

            const commitWidth = (widthPx) => {
                const pos = typeof getPos === 'function' ? getPos() : null;
                if (pos === null || pos === undefined) return;
                const tr = editor.view.state.tr.setNodeMarkup(pos, undefined, {
                    ...currentNode.attrs,
                    width: `${widthPx}px`,
                });
                editor.view.dispatch(tr);
            };

            const onPointerMove = (event) => {
                if (!resizeState) return;
                event.preventDefault();
                const nextWidth = resizeFromHandle(
                    resizeState.handle,
                    event.clientX - resizeState.startX,
                    event.clientY - resizeState.startY,
                    resizeState.startWidth,
                    resizeState.aspectRatio,
                );
                wrapper.style.width = `${nextWidth}px`;
                resizeState.currentWidth = nextWidth;
            };

            const onPointerUp = (event) => {
                document.removeEventListener('pointermove', onPointerMove);
                document.removeEventListener('pointerup', onPointerUp);
                if (!resizeState) return;
                const nextWidth = resizeFromHandle(
                    resizeState.handle,
                    event.clientX - resizeState.startX,
                    event.clientY - resizeState.startY,
                    resizeState.startWidth,
                    resizeState.aspectRatio,
                );
                resizeState = null;
                commitWidth(nextWidth);
            };

            chrome.querySelectorAll('[data-handle]').forEach((handleEl) => {
                handleEl.addEventListener('pointerdown', (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    const rect = getBoxRect();
                    resizeState = {
                        handle: handleEl.dataset.handle,
                        startX: event.clientX,
                        startY: event.clientY,
                        startWidth: rect.width || readWidthPx(),
                        aspectRatio: rect.height > 0 ? rect.width / rect.height : 1,
                        currentWidth: rect.width || readWidthPx(),
                    };
                    wrapper.style.width = `${resizeState.startWidth}px`;
                    document.addEventListener('pointermove', onPointerMove);
                    document.addEventListener('pointerup', onPointerUp, { once: true });
                });
            });

            applyState();

            return {
                dom: wrapper,
                contentDOM: null,
                update(updatedNode) {
                    if (updatedNode.type.name !== currentNode.type.name) return false;
                    currentNode = updatedNode;
                    applyState();
                    return true;
                },
                ignoreMutation() {
                    return true;
                },
                destroy() {
                    document.removeEventListener('pointermove', onPointerMove);
                    resizeState = null;
                },
            };
        };
    };

    const ResizableImage = Image.extend({
        addAttributes() {
            return {
                ...this.parent?.(),
                width: {
                    default: '100%',
                    parseHTML: element => element.getAttribute('width') || element.style.width || '100%',
                    renderHTML: attributes => attributes.width ? { width: attributes.width, style: `width: ${attributes.width}; max-width: 100%;` } : { style: 'max-width: 100%;' },
                },
                align: {
                    default: 'center',
                    parseHTML: element => element.getAttribute('data-align') || 'center',
                    renderHTML: attributes => attributes.align ? { 'data-align': attributes.align } : {},
                },
            };
        },
        addNodeView() {
            return createResizableMediaNodeView('image');
        },
    });

    const Video = Node.create({
        name: 'video',
        group: 'block',
        atom: true,
        draggable: true,
        selectable: true,
        addAttributes() {
            return {
                src: { default: null },
                controls: { default: true },
                title: { default: null },
                width: {
                    default: '100%',
                    parseHTML: element => element.getAttribute('width') || element.style.width || '100%',
                    renderHTML: attributes => attributes.width ? { width: attributes.width, style: `width: ${attributes.width}; max-width: 100%;` } : { style: 'max-width: 100%;' },
                },
                align: {
                    default: 'center',
                    parseHTML: element => element.getAttribute('data-align') || 'center',
                    renderHTML: attributes => attributes.align ? { 'data-align': attributes.align } : {},
                },
            };
        },
        parseHTML() {
            return [{ tag: 'video[src]' }];
        },
        renderHTML({ HTMLAttributes }) {
            return ['video', { ...HTMLAttributes, controls: 'controls' }];
        },
        addNodeView() {
            return createResizableMediaNodeView('video');
        },
    });

    const Audio = Node.create({
        name: 'audio',
        group: 'block',
        atom: true,
        draggable: true,
        selectable: true,
        addAttributes() {
            return {
                src: { default: null },
                title: { default: null },
                align: {
                    default: 'center',
                    parseHTML: element => element.getAttribute('data-align') || 'center',
                    renderHTML: attributes => attributes.align ? { 'data-align': attributes.align } : {},
                },
            };
        },
        parseHTML() {
            return [{ tag: 'audio[src]' }];
        },
        renderHTML({ HTMLAttributes }) {
            return ['audio', {
                ...HTMLAttributes,
                controls: 'controls',
                class: 'media-audio__media',
                'data-align': HTMLAttributes.align || 'center',
            }];
        },
    });

    // Instantiate TipTap
    const editor = new Editor({
        element: document.querySelector('#editor'),
        editorProps: {
            handleDrop(view, event, slice, moved) {
                if (event.dataTransfer.getData('text/x-tiptap-block')) {
                    const coordinates = view.posAtCoords({ left: event.clientX, top: event.clientY });
                    if (coordinates) {
                        const fromInsidePos = window.draggedPos;
                        if (fromInsidePos !== null && fromInsidePos !== undefined) {
                            try {
                                const $fromPos = view.state.doc.resolve(fromInsidePos);
                                const fromPos = $fromPos.before(1);
                                const node = view.state.doc.nodeAt(fromPos);

                                if (node) {
                                    const $targetPos = view.state.doc.resolve(coordinates.pos);
                                    const targetBlockPos = $targetPos.before(1);

                                    // Same block — no-op
                                    if (fromPos === targetBlockPos) {
                                        event.preventDefault();
                                        return true;
                                    }

                                    const tr = view.state.tr;
                                    // Delete source node first
                                    tr.delete(fromPos, fromPos + node.nodeSize);
