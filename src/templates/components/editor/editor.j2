                                    return true;
                                }
                            } catch (err) {
                                console.error('Error during block move:', err);
                            }
                        }
                    }
                }
                return false;
            }
        },
        extensions: [
            StarterKit.configure({
                orderedList: false,
                bulletList: false,
                dropcursor: false,
                link: false,
            }),
            CustomOrderedList,
            CustomBulletList,
            ResizableImage,
            Video,
            Audio,
            TableKit.configure({
                table: { resizable: true },
            }),
            //Underline,
            Highlight.configure({
                multicolor: true,
            }),
            TextStyle,
            Color,
            TextAlign.configure({
                types: ['heading', 'paragraph'],
            }),
            Link.configure({
                openOnClick: false,
                HTMLAttributes: {
                    class: 'editor-link',
                }
            }),
            Dropcursor.configure({
                color: '#3b82f6',
                width: 2,
            }),
            Placeholder.configure({
                emptyEditorClass: 'is-editor-empty',
                placeholder: 'Nhập nội dung tại đây 1223...',
            }),
        ],

        onSelectionUpdate({ editor }) {
            const event = new CustomEvent('tiptap-selection-change', { detail: { editor } });
            window.dispatchEvent(event);
            updateFloatingMenu(editor);
        },
        onUpdate({ editor }) {
            const event = new CustomEvent('tiptap-selection-change', { detail: { editor } });
            window.dispatchEvent(event);
            updateFloatingMenu(editor);
        }
    });

    function getContent() {
        editor.getJSON()
    }

    function importContent(content) {
        const jsonObject = typeof content === 'string' ? JSON.parse(content) : content;

        editor.commands.setContent(jsonObject, { contentType: 'json' });
    }

    window.myEditor = editor;
    window.myEditor.getContent = getContent;
    window.myEditor.importContent = importContent;

    // Floating menu: show on empty paragraphs
    function updateFloatingMenu(ed) {
        const wrapper = document.querySelector('.editor-wrapper');
        if (!wrapper || !window.Alpine) return;
        const alpineData = window.Alpine.$data(wrapper);
        if (!alpineData) return;

        const { state } = ed;
        const { $from } = state.selection;
        const selectedNode = state.selection.node;
        const isMediaNode = selectedNode && ['image', 'video', 'audio'].includes(selectedNode.type.name);

        if (isMediaNode) {
            try {
                const coords = ed.view.coordsAtPos($from.pos);
                const wrapperRect = wrapper.getBoundingClientRect();
                alpineData.mediaToolbar.top = coords.bottom - wrapperRect.top + 12;
                alpineData.mediaToolbar.left = Math.max(8, coords.left - wrapperRect.left);
