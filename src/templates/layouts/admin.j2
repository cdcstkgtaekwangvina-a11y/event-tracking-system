{% extends "templates/index.j2" %}
{% block title %}{% block admin_title %}{% endblock %}{% endblock %}

{% block head_extra %}
<link rel="stylesheet" href="/static/css/admin_container.css?v=20260822-1">
<link rel="stylesheet" href="/static/css/admin_events.css?v=20260822-1">
<link rel="stylesheet" href="/static/css/employees.css?v=20260826-1">
<link rel="stylesheet" href="/static/css/account.css?v=20260830-2">
<link rel="stylesheet" href="/static/css/media_manager.css?v=20260826-1">
<link rel="stylesheet" href="/static/css/queue_jobs.css?v=20260826-1">

<script src="/static/js/account.js?v=20260830-2"></script>
<script src="/static/js/employees.js?v=20260826-1"></script>
<script src="/static/js/admin_events.js?v=20260820-1"></script>
<script src="/static/js/media_manager.js?v=20260826-1"></script>
{% block admin_head_extra %}{% endblock %}
{% endblock %}

{% block body %}
{% if not auth.is_authenticated %}
<script>
    window.location.href = "/404";
</script>
{% else %}
<div style="display: flex; flex-direction: row; width: 100%; height: 100%;">
    {% include "templates/headers/sidebar.j2" %}
    <div id="admin-main-content" class="admin-main-content">
        {% block admin_body %}{% endblock %}
    </div>
</div>
{% endif %}
{% endblock %}
