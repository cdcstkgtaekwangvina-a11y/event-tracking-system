{% if not auth.is_authenticated %}
<script>
    window.location.href = "/404";
</script>
{% else %}
{% extends "templates/index.j2" %}
{% block title %}{% block admin_title %}{% endblock %}{% endblock %}

{% block body %}
<div style="display: flex; flex-direction: row; width: 100%; height: 100%;">
    {% include "templates/headers/sidebar.j2" %}
    <div id="admin-main-content" class="admin-main-content">
        {% block admin_body %}{% endblock %}
    </div>
</div>
<link rel="stylesheet" href="/static/css/admin_container.css">
<link rel="stylesheet" href="/static/css/admin_events.css?v=20260812-4">
{% endblock %}
{% endif %}
