<div class="home-container" x-data="{
    search: '',
    isLoading: false,
}">
    <section class="events-hero" aria-labelledby="events-heading">
        <h1 id="events-heading" class="section-title">Sự kiện sắp diễn ra</h1>
        <p class="hero-description">Khám phá và tham gia các sự kiện thú vị của công ty. Đừng bỏ lỡ những trải nghiệm
            đáng nhớ!</p>
        <span id="event-count" style="display: none;"></span>
    </section>

    <!-- Search and filters -->
    <section class="search-section" aria-labelledby="explore-heading">
        <h2 id="explore-heading" class="explore-title">Khám phá sự kiện</h2>
        <div class="search-bar-wrapper">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" name="search" placeholder="Tìm kiếm sự kiện theo tên..." x-model="search"
                @input.debounce.300ms="$dispatch('search-changed')" class="search-input" />
        </div>
        <div class="event-controls" aria-label="Bộ lọc sự kiện">
            <label>
                Trạng thái
                <select name="status" @change="$dispatch('event-filters-changed')">
                    <option value="all">Đang diễn ra & sắp diễn ra</option>
                    <option value="ongoing">Đang diễn ra</option>
                    <option value="upcoming">Sắp diễn ra</option>
                </select>
            </label>
            <label>
                Sắp xếp
                <select name="sort_field" @change="$dispatch('event-filters-changed')">
                    <option value="start_at">Thời gian bắt đầu</option>
                    <option value="name">Tên sự kiện</option>
                </select>
            </label>
            <label>
                Thứ tự
                <select name="is_desc" @change="$dispatch('event-filters-changed')">
                    <option value="false">Gần nhất trước</option>
                    <option value="true">Muộn nhất trước</option>
                </select>
            </label>
        </div>
    </section>

    <!-- Events List Container (Loaded and swapped via HTMX) -->
    <div id="events-container" hx-get="/api/events/cards-html"
        hx-trigger="load, search-changed from:body, event-filters-changed from:body"
        hx-include="[name='search'], [name='status'], [name='sort_field'], [name='is_desc']" hx-swap="innerHTML">
        <div class="spinner-container">
            <div class="spinner"></div>
            <p>Đang tải danh sách sự kiện...</p>
        </div>
    </div>
</div>

<style>
    /* CSS Reset / Base layout overrides */
    body {
        overflow-y: auto !important;
        background: var(--bg-home-page);
    }

    [x-cloak] {
        display: none !important;
    }

    .home-container {
        padding: 96px 20px 48px;
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-self: flex-start;
        gap: 0;
        box-sizing: border-box;
    }

    .events-hero,
    .search-section {
        background: var(--card);
        border: 1px solid var(--border);
    }

    .events-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 38px 24px 34px;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .hero-description {
        max-width: 590px;
        margin: 12px auto 0;
        color: var(--text-secondary);
        font-size: 14px;
        line-height: 1.65;
    }

    .event-total {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 18px 0 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    .event-total .material-symbols-outlined {
        font-size: 18px;
    }

    /* Search bar styling */
    .search-section {
        display: flex;
        flex-direction: column;
        gap: 18px;
        width: 100%;
        padding: 24px 24px 28px;
        border-top: 0;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        box-sizing: border-box;
    }

    .section-title {
        font-size: 26px;
        font-weight: 800;
        color: var(--foreground);
        margin: 0;
    }

    .explore-title {
        margin: 0;
        color: var(--foreground);
        font-size: 17px;
        font-weight: 800;
    }

    .search-bar-wrapper {
        position: relative;
        width: 100%;
    }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 9px 14px 9px 42px;
        border-radius: 7px;
        border: 1px solid var(--border);
        background-color: var(--card);
        color: var(--foreground);
        font-size: 15px;
        outline: none;
        box-shadow: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .search-input:focus {
        border-color: var(--foreground);
        box-shadow: 0 4px 12px var(--border);
    }

    .event-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 28px;
    }

    .event-controls label {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 400;
    }

    .event-controls select {
        min-height: 40px;
        min-width: 150px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--card);
        color: var(--foreground);
        padding: 0 34px 0 12px;
    }

    @media (max-width: 600px) {
        .home-container {
            padding-top: 84px;
            padding-left: 16px;
            padding-right: 16px;
        }

        .events-hero {
            padding: 30px 18px 28px;
        }

        .section-title {
            font-size: 23px;
        }

        .search-section {
            padding: 22px 18px 24px;
        }

        .event-controls label {
            flex: 1 1 100%;
            align-items: flex-start;
            flex-direction: column;
        }

        .event-controls select {
            width: 100%;
        }
    }

    .event-summary {
        margin: 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    /* Events Grid */
    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 30px;
        width: 100%;
        margin-top: 30px;
    }

    @media (max-width: 380px) {
        .events-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Event Card styling */
    .event-card {
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .event-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        text-decoration: none;
    }

    /* Header Gradient Themes */
    .card-header {
        height: 160px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .card-header .icon-large {
        font-size: 54px;
        color: #ffffff;
        opacity: 0.9;
    }

    .purple-blue {
        background: linear-gradient(135deg, #6366f1, #3b82f6);
    }

    .pink-red {
        background: linear-gradient(135deg, #ec4899, #ef4444);
    }

    .green-teal {
        background: linear-gradient(135deg, #10b981, #14b8a6);
    }

    .blue-dark {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
    }

    .purple-pink {
        background: linear-gradient(135deg, #a855f7, #ec4899);
    }

    .green-forest {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    /* Card Body Content */
    .card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 15px;
    }

    .event-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--foreground);
        margin: 0;
        line-height: 1.3;
    }

    .event-status {
        align-self: flex-start;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 10px;
    }

    .event-status--ongoing {
        background: #dcfce7;
        color: #166534;
    }

    .event-status--upcoming {
        background: #dbeafe;
        color: #1d4ed8;
    }

    /* Dark mode: badge màu sáng cố định trước đây gây chói/lệch tông trên card nền tối */
    :root[data-theme="dark"] .event-status--ongoing {
        background: rgba(34, 197, 94, 0.18);
        color: #4ade80;
    }

    :root[data-theme="dark"] .event-status--upcoming {
        background: rgba(59, 130, 246, 0.18);
        color: #60a5fa;
    }

    /* Địa điểm & thời gian gộp chung vào khối mô tả (event-desc-block), không còn hiển thị thành ô riêng */
    .event-desc-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* ĐOẠN CODE CŨ: cả ngày/giờ/địa điểm dùng chung 1 icon lịch, không có icon riêng cho địa điểm nên khó
       hình dung đâu là địa chỉ. Tách thành từng cụm icon+chữ riêng (.event-meta-item) qua flex-wrap. */
    .event-meta-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 14px;
        margin: 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .event-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .event-meta-line .material-symbols-outlined {
        font-size: 16px;
    }

    .event-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        height: 68px;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .event-info {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-top: 1px solid var(--border);
        padding-top: 15px;
        margin-top: 5px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .info-item span.material-symbols-outlined {
        font-size: 18px;
        color: var(--text-secondary);
        opacity: 0.8;
    }

    /* Actions */
    .register-btn {
        width: 100%;
        height: 44px;
        border: none;
        border-radius: 10px;
        background-color: var(--login-bg);
        color: var(--background);
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        margin-top: 10px;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .register-btn:hover {
        transform: scale(1.015);
        opacity: 0.95;
    }

    .register-btn:active {
        transform: scale(0.99);
    }

    /* Spinner and loading state */
    .spinner-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
        width: 100%;
        color: var(--text-secondary);
        gap: 15px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid var(--border);
        border-top: 4px solid var(--foreground);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .spinner-sm {
        width: 16px;
        height: 16px;
        border: 2px solid transparent;
        border-top: 2px solid var(--background);
        border-right: 2px solid var(--background);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        display: inline-block;
    }

    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        width: 100%;
    }

    .page-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border);
        background-color: var(--card);
        color: var(--foreground);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .page-btn:hover:not(:disabled) {
        background-color: var(--border);
    }

    .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .page-info {
        font-size: 14px;
        color: var(--foreground);
    }

    /* Empty search result state */
    /* ĐOẠN CODE CŨ: border-radius: 16px; -> không khớp với .admin-no-events (12px) bên trang admin, gây lệch kích thước giữa 2 khối tương đương. */
    /* ĐOẠN CODE CŨ: thiếu box-sizing: border-box -> padding + border bị cộng thêm ra ngoài width: 100%,
       khiến khối này tràn rộng hơn (lệch mép trái/phải) so với .search-section/.events-hero phía trên. */
    .no-events {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
        width: 100%;
        box-sizing: border-box;
        border: 1px dashed var(--border);
        border-radius: 12px;
        background-color: var(--card);
    }

    .icon-huge {
        font-size: 72px !important;
        color: var(--text-secondary);
        margin-bottom: 15px;
        opacity: 0.7;
    }

    .no-events h3 {
        margin: 0;
        font-size: 20px;
        color: var(--foreground);
    }

    .no-events p {
        margin: 8px 0 0 0;
        color: var(--text-secondary);
    }

    /* Modal styling */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 100000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .modal-container {
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        width: 90%;
        max-width: 440px;
        box-shadow: var(--nc-shadow-modal);
        overflow: hidden;
        position: relative;
        box-sizing: border-box;
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: var(--foreground);
    }

    .modal-close {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        padding: 4px;
        border-radius: 50%;
        transition: background-color 0.2s;
    }

    .modal-close:hover {
        background-color: var(--border);
    }

    .modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .modal-event-info {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-secondary);
        background-color: var(--bg-home-page);
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid var(--border);
    }

    .modal-event-info strong {
        font-size: 16px;
        display: inline-block;
        margin-top: 4px;
        color: var(--foreground);
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .input-group label {
        font-size: 14px;
        font-weight: 700;
        color: var(--foreground);
    }

    .modal-input {
        height: 40px;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background-color: var(--input);
        color: oklch(0.145 0 0);
        /* Naive input text color should be readable */
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

    .modal-input:focus {
        border-color: var(--foreground);
    }

    .helper-text {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 0;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background-color: var(--bg-home-page);
    }

    .btn-cancel {
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background-color: var(--card);
        color: var(--foreground);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-cancel:hover {
        background-color: var(--border);
    }

    .btn-submit {
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        border: none;
        background-color: var(--login-bg);
        color: var(--background);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: opacity 0.2s;
    }

    .btn-submit:hover:not(:disabled) {
        opacity: 0.95;
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>